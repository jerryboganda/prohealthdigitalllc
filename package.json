{
  "name": "prohealth-digital-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node -e \"require('fs').rmSync('.output',{recursive:true,force:true})\"",
    "build": "astro build",
    "preview": "node .output/server/index.mjs",
    "start": "node .output/server/index.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:routes": "node --experimental-strip-types scripts/check-routes.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/node": "^11.1.7",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "gsap": "^3.15.0",
    "lottie-web": "^5.13.0",
    "nodemailer": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "astro-og-canvas": "^0.13.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "hyperframes": "^0.8.145",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
