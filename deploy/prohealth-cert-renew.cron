SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
27 3 * * * root docker exec nginx-proxy-manager-app-1 certbot renew --cert-name prohealthdigitalllc.com --config-dir /etc/letsencrypt --work-dir /tmp/le-work --logs-dir /tmp/le-logs --quiet --deploy-hook "nginx -s reload" >> /var/log/prohealth-cert-renew.log 2>&1
