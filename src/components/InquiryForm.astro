---
import Icon from "./Icon.astro";
import { engagements, EMAIL, localPath, text } from "../lib/content.ts";
import type { Locale } from "../lib/content.ts";

interface Props {
  locale: Locale;
  engagement?: string;
  source: string;
}
const { locale, engagement, source } = Astro.props;
const copy = {
  name: text("Your name", "اسمك"),
  email: text("Work email", "البريد الإلكتروني المهني"),
  organization: text("Organization", "المؤسسة"),
  organizationType: text("Organization type", "نوع المؤسسة"),
  engagement: text("What would you like to do?", "ما الذي ترغب في تحقيقه؟"),
  stage: text("Project stage", "مرحلة المشروع"),
  country: text("Country", "الدولة"),
  timezone: text("Time zone", "المنطقة الزمنية"),
  brief: text("What problem would you like to solve?", "ما المشكلة التي ترغب في حلها؟"),
  language: text("Preferred communication language", "لغة التواصل المفضلة"),
  budget: text("Budget (optional)", "الميزانية (اختياري)"),
  choose: text("Please select", "يرجى الاختيار"),
  provider: text("Healthcare provider", "مقدم رعاية صحية"),
  company: text("Digital health company", "شركة صحة رقمية"),
  other: text("Other", "أخرى"),
  notSure: text("Not sure yet", "لم أحدد بعد"),
  discuss: text("Discuss during discovery", "للمناقشة خلال فهم الاحتياجات"),
  exploring: text("Exploring an idea", "استكشاف فكرة"),
  planning: text("Planning a project", "تخطيط مشروع"),
  building: text("Building a product", "تطوير منتج"),
  live: text("Running a live service", "تشغيل خدمة قائمة"),
  warning: text(
    "For business inquiries only. Do not include patient names, identifying information, medical histories or records. No attachments are accepted.",
    "لاستفسارات الأعمال فقط. لا تذكر أسماء المرضى أو معلومات تكشف هويتهم أو تاريخهم الطبي أو سجلاتهم. لا تُقبل المرفقات.",
  ),
  consent: text(
    "I have read the privacy policy and acknowledge how my inquiry information will be used.",
    "قرأت سياسة الخصوصية وأقر بكيفية استخدام معلومات استفساري.",
  ),
  policy: text("Read privacy policy", "اقرأ سياسة الخصوصية"),
  send: text("Send project inquiry", "أرسل استفسار المشروع"),
  sending: text("Sending…", "جارٍ الإرسال…"),
  thanks: text("Thank you for sharing your project", "شكرًا لمشاركة مشروعك"),
  accepted: text(
    "Your inquiry was accepted by our mail server. The team will review it and contact you about discovery. This does not confirm that a person has read it.",
    "قبل خادم البريد استفسارك. سيراجعه الفريق ويتواصل معك بشأن جلسة فهم الاحتياجات. لا يعني ذلك أن شخصًا قد قرأه بالفعل.",
  ),
  error: text(
    "We could not send your inquiry. Your details are still here. Please retry or email us directly.",
    "تعذر إرسال استفسارك. ما زالت بياناتك محفوظة في النموذج. حاول مجددًا أو راسلنا مباشرة.",
  ),
  invalid: text("Please check this field.", "يرجى مراجعة هذا الحقل."),
  validation: text(
    "Please review the marked fields before submitting.",
    "يرجى مراجعة الحقول المحددة قبل الإرسال.",
  ),
  rate: text(
    "Too many attempts. Please wait 15 minutes or email us directly.",
    "محاولات كثيرة. يرجى الانتظار 15 دقيقة أو مراسلتنا مباشرة.",
  ),
  briefHint: text(
    "20–3,000 characters. Describe who is affected and what needs to improve.",
    "من 20 إلى 3000 حرف. وضح من يتأثر بالمشكلة وما الذي يحتاج إلى تحسين.",
  ),
  followup: text(
    "Free discovery comes first. We assess fit and clarify requirements before preparing a scoped proposal. No technical specification or confirmed budget is required.",
    "تبدأ الرحلة بجلسة مجانية لفهم الاحتياجات. نقيّم ملاءمة المشروع ونوضح المتطلبات قبل إعداد عرض محدد النطاق. لا يلزم تقديم مواصفات تقنية أو ميزانية مؤكدة.",
  ),
  noscript: text(
    "This form requires JavaScript. Please email your business inquiry directly to",
    "يتطلب هذا النموذج JavaScript. يرجى إرسال استفسار الأعمال مباشرة إلى",
  ),
  legend: text("Project inquiry details", "تفاصيل استفسار المشروع"),
};
const messages: Record<string, string> = {
  name: text("Enter your name (2–100 characters).", "أدخل اسمك (من 2 إلى 100 حرف).")[locale],
  email: text("Enter a valid work email address.", "أدخل بريدًا إلكترونيًا مهنيًا صحيحًا.")[locale],
  organization: text(
    "Enter your organization (2–150 characters).",
    "أدخل اسم مؤسستك (من 2 إلى 150 حرفًا).",
  )[locale],
  organizationType: text("Select your organization type.", "اختر نوع مؤسستك.")[locale],
  stage: text("Select the current project stage.", "اختر مرحلة المشروع الحالية.")[locale],
  country: text("Enter your country.", "أدخل دولتك.")[locale],
  timezone: text("Enter your time zone.", "أدخل منطقتك الزمنية.")[locale],
  brief: copy.briefHint[locale],
  consent: text("Please acknowledge the privacy policy.", "يرجى الإقرار بسياسة الخصوصية.")[locale],
};
const t = (k: keyof typeof copy) => copy[k][locale];
const selected = engagement || "not-sure";
---

<div
  class="inquiry"
  data-inquiry-form
  data-locale={locale}
  data-source={source}
  data-msg-invalid={t("invalid")}
  data-msg-validation={t("validation")}
  data-msg-error={t("error")}
  data-msg-rate={t("rate")}
  data-msg-sending={t("sending")}
>
  <form method="post" action="/api/inquiries" novalidate class="grid gap-7">
    <noscript>
      <p class="form-banner">
        {t("noscript")}{" "}
        <a href={`mailto:${EMAIL}`} dir="ltr">
          {EMAIL}
        </a>
      </p>
    </noscript>
    <p class="form-banner" id="inquiry-warning">
      <Icon name="shield" size={20} class="shrink-0 text-teal-700" />
      <span>{t("warning")}</span>
    </p>
    <fieldset class="grid gap-7">
      <legend class="sr-only">{t("legend")}</legend>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="field">
          <label for="inquiry-name">{t("name")}</label>
          <input
            class="input"
            id="inquiry-name"
            name="name"
            autocomplete="name"
            minlength="2"
            maxlength="100"
            required
            data-msg={messages.name}
          />
        </div>
        <div class="field">
          <label for="inquiry-email">{t("email")}</label>
          <input
            class="input"
            id="inquiry-email"
            name="email"
            type="email"
            dir="ltr"
            autocomplete="email"
            maxlength="254"
            required
            data-msg={messages.email}
          />
        </div>
        <div class="field">
          <label for="inquiry-organization">{t("organization")}</label>
          <input
            class="input"
            id="inquiry-organization"
            name="organization"
            autocomplete="organization"
            minlength="2"
            maxlength="150"
            required
            data-msg={messages.organization}
          />
        </div>
        <div class="field">
          <label for="inquiry-organizationType">{t("organizationType")}</label>
          <select
            class="input"
            id="inquiry-organizationType"
            name="organizationType"
            required
            data-msg={messages.organizationType}
          >
            <option value="">{t("choose")}</option>
            <option value="provider">{t("provider")}</option>
            <option value="digital-health">{t("company")}</option>
            <option value="other">{t("other")}</option>
          </select>
        </div>
        <div class="field">
          <label for="inquiry-engagement">{t("engagement")}</label>
          <select class="input" id="inquiry-engagement" name="engagement" required>
            <option value="not-sure" selected={selected === "not-sure"}>
              {t("notSure")}
            </option>
            {engagements.map((e) => (
              <option value={e.id} selected={selected === e.id}>
                {e.title[locale]}
              </option>
            ))}
          </select>
        </div>
        <div class="field">
          <label for="inquiry-stage">{t("stage")}</label>
          <select class="input" id="inquiry-stage" name="stage" required data-msg={messages.stage}>
            <option value="">{t("choose")}</option>
            {(["exploring", "planning", "building", "live"] as const).map((s) => (
              <option value={s}>{t(s)}</option>
            ))}
          </select>
        </div>
        <div class="field">
          <label for="inquiry-country">{t("country")}</label>
          <input
            class="input"
            id="inquiry-country"
            name="country"
            autocomplete="country-name"
            minlength="2"
            maxlength="100"
            required
            data-msg={messages.country}
          />
        </div>
        <div class="field">
          <label for="inquiry-timezone">{t("timezone")}</label>
          <input
            class="input"
            id="inquiry-timezone"
            name="timezone"
            placeholder={locale === "ar" ? "مثال: آسيا / الرياض، UTC+3" : "e.g. Asia/Riyadh, UTC+3"}
            minlength="2"
            maxlength="100"
            required
            data-msg={messages.timezone}
          />
        </div>
        <div class="field">
          <label for="inquiry-language">{t("language")}</label>
          <select class="input" id="inquiry-language" name="language">
            <option value="en" selected={locale === "en"}>
              {locale === "ar" ? "الإنجليزية" : "English"}
            </option>
            <option value="ar" selected={locale === "ar"}>
              {locale === "ar" ? "العربية" : "Arabic"}
            </option>
          </select>
        </div>
        <div class="field">
          <label for="inquiry-budget">{t("budget")}</label>
          <select class="input" id="inquiry-budget" name="budget">
            <option value="not-sure">{t("notSure")}</option>
            <option value="discuss">{t("discuss")}</option>
          </select>
        </div>
      </div>
      <div class="field">
        <label for="inquiry-brief">{t("brief")}</label>
        <textarea
          class="input"
          id="inquiry-brief"
          name="brief"
          rows="6"
          minlength="20"
          maxlength="3000"
          required
          aria-describedby="brief-hint"
          data-msg={messages.brief}
        ></textarea>
        <small id="brief-hint" class="muted text-[0.9rem]">
          {t("briefHint")}
        </small>
      </div>
      <div class="honeypot" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>
      <label class="consent">
        <input
          name="consent"
          id="inquiry-consent"
          type="checkbox"
          required
          data-msg={messages.consent}
        />
        <span>
          {t("consent")}{" "}
          <a class="text-link" href={localPath("/privacy", locale)}>
            {t("policy")}
          </a>
        </span>
      </label>
    </fieldset>
    <div role="alert" class="form-error" data-form-alert hidden></div>
    <div class="flex flex-wrap items-center gap-5">
      <button class="btn" type="submit" data-magnetic>
        <span data-submit-label>{t("send")}</span>
        <Icon name="arrow" size={18} directional />
      </button>
    </div>
    <p class="muted text-[0.95rem]">{t("followup")}</p>
  </form>
  <div class="inquiry-success" role="status" tabindex="-1" hidden>
    <span class="success-icon" aria-hidden="true">
      <Icon name="check" size={28} />
    </span>
    <h2>{t("thanks")}</h2>
    <p>{t("accepted")}</p>
    <a class="text-link" href={`mailto:${EMAIL}`} dir="ltr">
      {EMAIL}
    </a>
  </div>
</div>

<style>
  .form-banner {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem 1.15rem;
    border-radius: 1rem;
    background: var(--color-mint);
    color: var(--color-ink);
    font-size: 0.95rem;
  }
  .honeypot {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .consent {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    font-size: 0.97rem;
  }
  .consent input {
    flex: none;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    margin-block-start: 0.2rem;
    accent-color: var(--color-royal);
  }
  .form-error {
    padding: 1rem 1.15rem;
    border-radius: 1rem;
    background: #fbeeee;
    color: var(--color-error);
    font-weight: 500;
  }
  .form-error a {
    text-decoration: underline;
  }
  .inquiry-success {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding: clamp(1.75rem, 1rem + 3vw, 3rem);
    border-radius: var(--radius-card);
    background: var(--color-mint);
  }
  .inquiry-success:focus {
    outline: none;
  }
  .success-icon {
    display: grid;
    place-items: center;
    inline-size: 3.5rem;
    block-size: 3.5rem;
    border-radius: 999px;
    background: var(--color-teal);
    color: #fff;
  }
  fieldset[disabled] {
    opacity: 0.65;
  }
</style>
