---
import Icon from "./Icon.astro";
import { engagements, EMAIL, localPath, text } from "../lib/content.ts";
import type { Locale } from "../lib/content.ts";
import { ui2 } from "../lib/copy.ts";
import { companyUi } from "../lib/copy-company.ts";

interface Props {
  locale: Locale;
  engagement?: string;
  source: string;
}
const { locale, engagement, source } = Astro.props;
const copy = {
  name: text("Your name", "اسمك"),
  email: text("Work email", "البريد الإلكتروني المهني"),
  organization: text("Organization", "المؤسسة"),
  organizationType: text("Organization type", "نوع المؤسسة"),
  engagement: text("What would you like to do?", "ما الذي ترغب في تحقيقه؟"),
  stage: text("Project stage", "مرحلة المشروع"),
  country: text("Country", "الدولة"),
  timezone: text("Time zone", "المنطقة الزمنية"),
  brief: text("What problem would you like to solve?", "ما المشكلة التي ترغب في حلها؟"),
  language: text("Preferred communication language", "لغة التواصل المفضلة"),
  budget: text("Budget (optional)", "الميزانية (اختياري)"),
  choose: text("Please select", "يرجى الاختيار"),
  provider: text("Healthcare provider", "مقدم رعاية صحية"),
  company: text("Digital health company", "شركة صحة رقمية"),
  other: text("Other", "أخرى"),
  notSure: text("Not sure yet", "لم أحدد بعد"),
  discuss: text("Discuss during discovery", "للمناقشة خلال فهم الاحتياجات"),
  exploring: text("Exploring an idea", "استكشاف فكرة"),
  planning: text("Planning a project", "تخطيط مشروع"),
  building: text("Building a product", "تطوير منتج"),
  live: text("Running a live service", "تشغيل خدمة قائمة"),
  warning: text(
    "For business inquiries only. Do not include patient names, identifying information, medical histories or records. No attachments are accepted.",
    "لاستفسارات الأعمال فقط. لا تذكر أسماء المرضى أو معلومات تكشف هويتهم أو تاريخهم الطبي أو سجلاتهم. لا تُقبل المرفقات.",
  ),
  consent: text(
    "I have read the privacy policy and acknowledge how my inquiry information will be used.",
    "قرأت سياسة الخصوصية وأقر بكيفية استخدام معلومات استفساري.",
  ),
  policy: text("Read privacy policy", "اقرأ سياسة الخصوصية"),
  send: text("Send project inquiry", "أرسل استفسار المشروع"),
  sending: text("Sending…", "جارٍ الإرسال…"),
  thanks: text("Thank you for sharing your project", "شكرًا لمشاركة مشروعك"),
  accepted: text(
    "Your inquiry was accepted by our mail server. The team will review it and contact you about discovery. This does not confirm that a person has read it.",
    "قبل خادم البريد استفسارك. سيراجعه الفريق ويتواصل معك بشأن جلسة فهم الاحتياجات. لا يعني ذلك أن شخصًا قد قرأه بالفعل.",
  ),
  error: text(
    "We could not send your inquiry. Your details are still here. Please retry or email us directly.",
    "تعذر إرسال استفسارك. ما زالت بياناتك محفوظة في النموذج. حاول مجددًا أو راسلنا مباشرة.",
  ),
  invalid: text("Please check this field.", "يرجى مراجعة هذا الحقل."),
  validation: text(
    "Please review the marked fields before submitting.",
    "يرجى مراجعة الحقول المحددة قبل الإرسال.",
  ),
  rate: text(
    "Too many attempts. Please wait 15 minutes or email us directly.",
    "محاولات كثيرة. يرجى الانتظار 15 دقيقة أو مراسلتنا مباشرة.",
  ),
  briefHint: text(
    "20–3,000 characters. Describe who is affected and what needs to improve.",
    "من 20 إلى 3000 حرف. وضح من يتأثر بالمشكلة وما الذي يحتاج إلى تحسين.",
  ),
  followup: companyUi.followup,
  noscript: text(
    "This form requires JavaScript. Please email your business inquiry directly to",
    "يتطلب هذا النموذج JavaScript. يرجى إرسال استفسار الأعمال مباشرة إلى",
  ),
  legend: text("Project inquiry details", "تفاصيل استفسار المشروع"),
};
const messages: Record<string, string> = {
  name: text("Enter your name (2–100 characters).", "أدخل اسمك (من 2 إلى 100 حرف).")[locale],
  email: text("Enter a valid work email address.", "أدخل بريدًا إلكترونيًا مهنيًا صحيحًا.")[locale],
  organization: text(
    "Enter your organization (2–150 characters).",
    "أدخل اسم مؤسستك (من 2 إلى 150 حرفًا).",
  )[locale],
  organizationType: text("Select your organization type.", "اختر نوع مؤسستك.")[locale],
  stage: text("Select the current project stage.", "اختر مرحلة المشروع الحالية.")[locale],
  country: text("Enter your country.", "أدخل دولتك.")[locale],
  timezone: text("Enter your time zone.", "أدخل منطقتك الزمنية.")[locale],
  brief: copy.briefHint[locale],
  consent: text("Please acknowledge the privacy policy.", "يرجى الإقرار بسياسة الخصوصية.")[locale],
};
const t = (k: keyof typeof copy) => copy[k][locale];
const selected = engagement || "not-sure";
const [reqBefore, reqAfter = ""] = ui2.requiredNote[locale].split("*");
---

<div
  class="inquiry"
  data-inquiry-form
  data-locale={locale}
  data-source={source}
  data-msg-invalid={t("invalid")}
  data-msg-validation={t("validation")}
  data-msg-error={t("error")}
  data-msg-rate={t("rate")}
  data-msg-sending={t("sending")}
>
  <form method="post" action="/api/inquiries" novalidate class="lg-form" style="gap: 26px">
    <noscript>
      <p class="lg-callout form-banner">
        <span>
          {t("noscript")}{" "}
          <a class="lg-link" href={`mailto:${EMAIL}`} dir="ltr">
            {EMAIL}
          </a>
        </span>
      </p>
    </noscript>
    <p class="lg-callout form-banner" id="inquiry-warning">
      <Icon name="shield" size={22} class="form-banner-ico" />
      <span>{t("warning")}</span>
    </p>
    {/* Disabled until inquiry-form.ts enables it: the form never posts natively to the JSON API. */}
    <fieldset class="form-set" disabled>
      <legend class="lg-sr">{t("legend")}</legend>
      <div class="form-grid">
        <div class="lg-field">
          <label class="lg-label" for="inquiry-name">
            {t("name")}{" "}
            <span class="lg-req" aria-hidden="true">
              *
            </span>
          </label>
          <input
            class="lg-input"
            id="inquiry-name"
            name="name"
            autocomplete="name"
            minlength="2"
            maxlength="100"
            required
            data-msg={messages.name}
          />
        </div>
        <div class="lg-field">
          <label class="lg-label" for="inquiry-email">
            {t("email")}{" "}
            <span class="lg-req" aria-hidden="true">
              *
            </span>
          </label>
          <input
            class="lg-input"
            id="inquiry-email"
            name="email"
            type="email"
            dir="ltr"
            autocomplete="email"
            maxlength="254"
            required
            data-msg={messages.email}
          />
        </div>
        <div class="lg-field">
          <label class="lg-label" for="inquiry-organization">
            {t("organization")}{" "}
            <span class="lg-req" aria-hidden="true">
              *
            </span>
          </label>
          <input
            class="lg-input"
            id="inquiry-organization"
            name="organization"
            autocomplete="organization"
            minlength="2"
            maxlength="150"
            required
            data-msg={messages.organization}
          />
        </div>
        <div class="lg-field">
          <label class="lg-label" for="inquiry-organizationType">
            {t("organizationType")}{" "}
            <span class="lg-req" aria-hidden="true">
              *
            </span>
          </label>
          <select
            class="lg-select"
            id="inquiry-organizationType"
            name="organizationType"
            required
            data-msg={messages.organizationType}
          >
            <option value="">{t("choose")}</option>
            <option value="provider">{t("provider")}</option>
            <option value="digital-health">{t("company")}</option>
            <option value="other">{t("other")}</option>
          </select>
        </div>
        <div class="lg-field">
          <label class="lg-label" for="inquiry-engagement">
            {t("engagement")}{" "}
            <span class="lg-req" aria-hidden="true">
              *
            </span>
          </label>
          <select class="lg-select" id="inquiry-engagement" name="engagement" required>
            <option value="not-sure" selected={selected === "not-sure"}>
              {t("notSure")}
            </option>
            {engagements.map((e) => (
              <option value={e.id} selected={selected === e.id}>
                {e.title[locale]}
              </option>
            ))}
          </select>
        </div>
        <div class="lg-field">
          <label class="lg-label" for="inquiry-stage">
            {t("stage")}{" "}
            <span class="lg-req" aria-hidden="true">
              *
            </span>
          </label>
          <select
            class="lg-select"
            id="inquiry-stage"
            name="stage"
            required
            data-msg={messages.stage}
          >
            <option value="">{t("choose")}</option>
            {(["exploring", "planning", "building", "live"] as const).map((s) => (
              <option value={s}>{t(s)}</option>
            ))}
          </select>
        </div>
        <div class="lg-field">
          <label class="lg-label" for="inquiry-country">
            {t("country")}{" "}
            <span class="lg-req" aria-hidden="true">
              *
            </span>
          </label>
          <input
            class="lg-input"
            id="inquiry-country"
            name="country"
            autocomplete="country-name"
            minlength="2"
            maxlength="100"
            required
            data-msg={messages.country}
          />
        </div>
        <div class="lg-field">
          <label class="lg-label" for="inquiry-timezone">
            {t("timezone")}{" "}
            <span class="lg-req" aria-hidden="true">
              *
            </span>
          </label>
          <input
            class="lg-input"
            id="inquiry-timezone"
            name="timezone"
            placeholder={locale === "ar" ? "مثال: آسيا / الرياض، UTC+3" : "e.g. Asia/Riyadh, UTC+3"}
            minlength="2"
            maxlength="100"
            required
            data-msg={messages.timezone}
          />
        </div>
        <div class="lg-field">
          <label class="lg-label" for="inquiry-language">
            {t("language")}
          </label>
          <select class="lg-select" id="inquiry-language" name="language">
            <option value="en" selected={locale === "en"}>
              {locale === "ar" ? "الإنجليزية" : "English"}
            </option>
            <option value="ar" selected={locale === "ar"}>
              {locale === "ar" ? "العربية" : "Arabic"}
            </option>
          </select>
        </div>
        <div class="lg-field">
          <label class="lg-label" for="inquiry-budget">
            {t("budget")}
          </label>
          <select class="lg-select" id="inquiry-budget" name="budget">
            <option value="not-sure">{t("notSure")}</option>
            <option value="discuss">{t("discuss")}</option>
          </select>
        </div>
      </div>
      <div class="lg-field">
        <label class="lg-label" for="inquiry-brief">
          {t("brief")}{" "}
          <span class="lg-req" aria-hidden="true">
            *
          </span>
        </label>
        <textarea
          class="lg-textarea"
          id="inquiry-brief"
          name="brief"
          rows="6"
          minlength="20"
          maxlength="3000"
          required
          aria-describedby="brief-hint"
          data-msg={messages.brief}
        ></textarea>
        <small id="brief-hint" class="lg-hint">
          {t("briefHint")}
        </small>
      </div>
      <div class="honeypot" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>
      <div class="lg-field">
        <label class="lg-checkrow consent">
          <input
            name="consent"
            id="inquiry-consent"
            type="checkbox"
            required
            data-msg={messages.consent}
          />
          <span>
            {t("consent")}{" "}
            <span class="lg-req" aria-hidden="true">
              *
            </span>
          </span>
        </label>
        <a class="lg-link consent-link" href={localPath("/privacy", locale)}>
          {t("policy")}
          <Icon name="arrow" size={18} class="lg-arrow" />
        </a>
      </div>
    </fieldset>
    <p class="lg-hint" style="margin: 0">
      {reqBefore}
      <span class="lg-req" aria-hidden="true">
        *
      </span>
      {reqAfter}
    </p>
    <div role="alert" class="lg-summary-err" data-form-alert hidden>
      {t("error")}{" "}
      <a href={`mailto:${EMAIL}`} dir="ltr">
        {EMAIL}
      </a>
    </div>
    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 20px">
      <button class="lg-btn" type="submit" disabled data-magnetic>
        <span data-submit-label>{t("send")}</span>
        <span class="lg-btn-ico" aria-hidden="true">
          <Icon name="arrow" size={18} />
        </span>
      </button>
    </div>
    <p class="lg-body" style="font-size: 15px">
      {t("followup")}
    </p>
  </form>
  <div class="inquiry-success lg-success" role="status" tabindex="-1" hidden>
    <span
      class="success-icon"
      aria-hidden="true"
      data-lottie="/lottie/check.json"
      data-loop="false"
    >
      <Icon name="check" size={32} />
    </span>
    <h2 class="lg-h3" style="font-size: clamp(26px, 2.6vw, 36px)">
      {t("thanks")}
    </h2>
    <p class="lg-body" style="color: var(--ink-2); max-width: 60ch">
      {t("accepted")}
    </p>
    <a class="lg-link" href={`mailto:${EMAIL}`} dir="ltr">
      {EMAIL}
    </a>
  </div>
</div>

<style>
  .form-banner {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin: 0;
    padding: 18px 20px;
    font-size: 15px;
    color: var(--ink);
  }
  .form-banner :global(.form-banner-ico) {
    flex: none;
    margin-block-start: 1px;
    color: var(--teal-ink);
  }
  .form-set {
    display: grid;
    gap: 24px;
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .form-set[disabled] {
    opacity: 0.65;
  }
  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 22px 20px;
  }
  .honeypot {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .consent {
    min-block-size: 44px;
    align-items: center;
  }
  .consent-link {
    margin-inline-start: 34px;
  }
  /* Field errors are created by inquiry-form.ts, so they sit outside this component's scope. */
  .inquiry :global(.field-error) {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 14px;
    color: var(--error);
  }
  .inquiry :global(.lg-checkrow + .field-error) {
    margin-inline-start: 34px;
  }
  .lg-summary-err {
    font-weight: 500;
  }
  .lg-summary-err :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .inquiry-success {
    padding: clamp(28px, 4vw, 48px);
  }
  .inquiry-success:focus {
    outline: none;
  }
  .success-icon {
    display: grid;
    place-items: center;
    inline-size: 72px;
    block-size: 72px;
    border-radius: 50%;
    background: #fff;
    color: var(--teal-ink);
    box-shadow: 0 0 0 1px var(--line);
  }
  .success-icon :global(svg) {
    inline-size: 100%;
    block-size: 100%;
  }
</style>
