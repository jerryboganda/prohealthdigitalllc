---
import Icon from "./Icon.astro";
import { localPath } from "../lib/content.ts";
import type { Locale } from "../lib/content.ts";
import { common } from "../lib/copy.ts";

interface Props {
  locale: Locale;
  href: string;
  title: string;
  description: string;
  label: string;
  date?: Date;
  minutes?: number;
  index?: number;
  level?: "h2" | "h3";
  /** Audience key for listing filters ("providers" | "digital-health-companies" | "both"). */
  audience?: string;
  cta?: string;
}
const {
  locale,
  href,
  title,
  description,
  label,
  date,
  minutes,
  index = 0,
  level = "h3",
  audience,
  cta,
} = Astro.props;
const Heading = level;
const art = ["", "is-teal", "is-ink"][index % 3];
const fmt = new Intl.DateTimeFormat(locale === "ar" ? "ar-u-nu-latn" : "en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="lg-article" data-audience={audience}>
  <div class:list={["lg-article-art", art]} aria-hidden="true"></div>
  <div class="lg-article-body">
    <div class="lg-meta">
      <span class:list={["lg-tag", index % 3 === 1 && "lg-tag-teal"]}>{label}</span>
      {date && <time datetime={date.toISOString().slice(0, 10)}>{fmt.format(date)}</time>}
      {minutes && (
        <span>
          {minutes} {common.minutes[locale]}
        </span>
      )}
    </div>
    <Heading class="lg-h3">
      <a class="lg-stretch" href={localPath(href, locale)}>
        {title}
      </a>
    </Heading>
    <p class="lg-body" style="font-size: 15px">
      {description}
    </p>
    <span class="lg-link" aria-hidden="true">
      {cta ?? common.readArticle[locale]}
      <Icon name="arrow" size={18} class="lg-arrow" />
    </span>
  </div>
</article>
