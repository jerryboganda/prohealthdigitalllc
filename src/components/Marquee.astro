---
/** Two counter-running rows of pills. Pauses on hover/focus and with the site-wide motion-pause control. */
import type { Locale, Localized } from "../lib/content.ts";

interface Props {
  locale: Locale;
  items: Localized[];
  /** Kept for callers; the site-wide "Pause animations" control replaces the per-marquee toggle. */
  pauseLabel?: string;
  /** One row (CTA band) or two counter-running rows. */
  rows?: 1 | 2;
  tone?: "light" | "royal";
}
const { locale, items, rows = 2, tone = "light" } = Astro.props;
const words = items.map((i) => i[locale]);
const looks = ["is-ink", "is-teal", "is-royal", "", "is-ink", "is-teal", ""];
---

<div
  class:list={["marquee-rows", tone === "royal" && "lg-on-royal"]}
  style="display: grid; gap: 12px"
>
  <div class="lg-marquee">
    <div class="lg-track">
      <div>
        {words.map((w) => (
          <span class="lg-pill">{w}</span>
        ))}
      </div>
      <div aria-hidden="true">
        {words.map((w) => (
          <span class="lg-pill">{w}</span>
        ))}
      </div>
    </div>
  </div>
  {rows === 2 && (
    <div class="lg-marquee" aria-hidden="true">
      <div class="lg-track lg-track-rev" style="animation-duration: 46s">
        <div>
          {[...words].reverse().map((w, i) => (
            <span class:list={["lg-pill", looks[i % looks.length]]}>{w}</span>
          ))}
        </div>
        <div>
          {[...words].reverse().map((w, i) => (
            <span class:list={["lg-pill", looks[i % looks.length]]}>{w}</span>
          ))}
        </div>
      </div>
    </div>
  )}
</div>
