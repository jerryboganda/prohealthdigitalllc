---
import type { Locale, Localized } from "../lib/content.ts";

interface Props {
  locale: Locale;
  items: Localized[];
}
const { locale, items } = Astro.props;
const words = items.map((i) => i[locale]);
---

<div class="marquee" role="region" aria-label={words.join(" · ")}>
  <div class="marquee-track" aria-hidden="true">
    {[0, 1].map(() => (
      <ul class="marquee-group">
        {words.map((w) => (
          <li>
            <span class="marquee-star">✦</span>
            {w}
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--color-line);
    padding-block: 1.35rem;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee-track {
    display: flex;
    inline-size: max-content;
  }
  .marquee-group {
    display: flex;
    gap: 3rem;
    padding-inline-end: 3rem;
  }
  .marquee-group li {
    display: inline-flex;
    align-items: center;
    gap: 3rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 1.1vw, 2.1rem);
    white-space: nowrap;
    color: var(--color-ink);
  }
  .marquee-star {
    color: var(--color-teal);
    font-size: 0.7em;
  }
</style>
