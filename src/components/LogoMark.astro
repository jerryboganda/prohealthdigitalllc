---
// PD monogram rebuilt from public/prohealth-logo.png (coordinates in the source PNG's pixel space).
interface Props {
  class?: string;
  title?: string;
  animate?: boolean;
}
const { class: className, title, animate = false } = Astro.props;
const id = "pdmark";
---

<svg
  class:list={["logo-mark", className]}
  viewBox="405 312 448 386"
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  aria-label={title}
  data-intro={animate ? "" : undefined}
>
  <defs>
    <linearGradient id={`${id}-arc`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#18BDB3" />
      <stop offset="1" stop-color="#1B4ED8" />
    </linearGradient>
  </defs>
  <path
    class="mark-arc"
    d="M487 408C440 440 418 490 428 540C438 600 470 640 507 660"
    fill="none"
    stroke={`url(#${id}-arc)`}
    stroke-width="4.5"
    stroke-linecap="round"
  ></path>
  <g class="mark-dots">
    <circle cx="487" cy="408" r="18" fill="#19BDB3"></circle>
    <circle cx="428" cy="470" r="17" fill="#1AB1B2"></circle>
    <circle cx="437" cy="588" r="16" fill="#1F55D2"></circle>
    <circle
      cx="507"
      cy="660"
      r="19"
      fill="#1B4ED8"
      stroke="#fff"
      stroke-width="6"
      paint-order="stroke"
    ></circle>
  </g>
  <path
    class="mark-p"
    fill="#0A1D3D"
    fill-rule="evenodd"
    d="M455 320H615C672 320 716 362 716 410C716 460 672 500 615 500H546V690L500 652V362ZM546 366H612C641 366 663 386 663 411C663 437 641 457 612 457H546Z"
  ></path>
  <path
    class="mark-d"
    fill="#1B4ED8"
    d="M737 427C801 440 846 492 846 557C846 632 786 690 701 690H578V600H625V648H701C756 648 797 608 797 557C797 512 771 479 737 470Z"
  ></path>
  <path
    class="mark-pulse"
    d="M578 575H651L675 524L699 610L718 571L783 567"
    fill="none"
    stroke="#18BDB3"
    stroke-width="14"
    stroke-linejoin="miter"
    stroke-miterlimit="3"
  ></path>
</svg>
