---
import Icon from "./Icon.astro";
import Marquee from "./Marquee.astro";
import ArtGrid from "./ArtGrid.astro";
import { EMAIL, WHATSAPP, localPath, ui } from "../lib/content.ts";
import type { Locale } from "../lib/content.ts";
import { common, home } from "../lib/copy.ts";

interface Props {
  locale: Locale;
  source: string;
  engagement?: string;
}
const { locale, source, engagement } = Astro.props;
const params = new URLSearchParams({ ...(engagement ? { engagement } : {}), source });
---

<section style="padding: 0 var(--gutter) clamp(56px, 7vw, 100px)">
  <div class="lg-on-royal cta-band" data-reveal="scale">
    <ArtGrid
      motion="spin"
      class="cta-art"
      cells={["#fff", undefined, "#fff", undefined, "#fff", undefined, "#fff", undefined, "#fff"]}
    />
    <div class="cta-copy">
      <h2 class="lg-h2" style="max-width: 16ch; color: #fff">
        {ui.discovery[locale]}
      </h2>
      <p class="cta-body">{ui.discoveryBody[locale]}</p>
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px">
        <a
          class="lg-btn lg-btn-w"
          href={`${localPath("/contact", locale)}?${params}`}
          data-magnetic
        >
          <span>{ui.cta[locale]}</span>
          <span class="lg-btn-ico" aria-hidden="true">
            <Icon name="arrow" size={18} />
          </span>
        </a>
        <a class="lg-ghost lg-ghost-w" href={`mailto:${EMAIL}`} style="min-height: 60px">
          <Icon name="mail" size={18} />
          {ui.email[locale]}
        </a>
        {WHATSAPP && (
          <a
            class="lg-ghost lg-ghost-w"
            href={`https://wa.me/${WHATSAPP}`}
            rel="noopener"
            target="_blank"
            style="min-height: 60px"
          >
            <Icon name="whatsapp" size={18} />
            {common.whatsapp[locale]}
            <span class="lg-sr">{common.external[locale]}</span>
          </a>
        )}
      </div>
    </div>
    <Marquee locale={locale} items={home.marquee} rows={1} tone="royal" />
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    isolation: isolate;
    max-width: var(--maxw);
    margin: 0 auto;
    border-radius: var(--r-xl);
    background: var(--royal);
    color: #fff;
    overflow: hidden;
    display: grid;
    gap: 44px;
    padding: clamp(56px, 8vw, 110px) 0 clamp(36px, 5vw, 56px);
  }
  .cta-band :global(.cta-art) {
    position: absolute;
    inset-inline-end: -80px;
    top: -80px;
    width: 320px;
    opacity: 0.18;
    z-index: -1;
    animation-duration: 60s;
  }
  .cta-copy {
    display: grid;
    justify-items: center;
    gap: 24px;
    text-align: center;
    padding: 0 clamp(20px, 4vw, 56px);
  }
  .cta-body {
    margin: 0;
    max-width: 60ch;
    font-size: 18px;
    line-height: 1.6;
    color: #e6ecff;
  }
</style>
