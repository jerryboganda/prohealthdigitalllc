---
import Icon from "./Icon.astro";
import ArtGrid from "./ArtGrid.astro";
import { projects, localPath, ui } from "../lib/content.ts";
import type { Locale } from "../lib/content.ts";
import { common } from "../lib/copy.ts";

interface Props {
  locale: Locale;
  level?: "h2" | "h3";
  /** Leave out one project (e.g. the one being viewed). */
  exclude?: string;
}
const { locale, level = "h3", exclude } = Astro.props;
const Heading = level;
const looks = [
  { bg: "var(--royal-50)", cells: [] as (string | undefined)[] },
  { bg: "var(--teal-50)", cells: [] },
  {
    bg: "var(--ink)",
    cells: [
      undefined,
      "#24365a",
      undefined,
      "#13308f",
      "var(--mint)",
      undefined,
      "#24365a",
      undefined,
      "#13308f",
    ],
  },
];
const list = projects.filter((p) => p.id !== exclude);
---

<ol style="margin: 0; padding: 0; list-style: none; display: grid; gap: 20px">
  {list.map((p, i) => {
    const look = looks[projects.indexOf(p) % looks.length];
    const art = (
      <div class="lg-project-art" aria-hidden="true" style={`background: ${look.bg}`}>
        <ArtGrid cells={look.cells} />
      </div>
    );
    return (
      <li class="lg-project" data-reveal="scale">
        {i % 2 === 0 && art}
        <div class="lg-project-body">
          <div class="lg-meta">
            <span class="lg-tag">{p.category[locale]}</span>
            <span class="lg-tag lg-tag-teal">
              <Icon name="check" size={14} />
              {ui.projectRole[locale]}
            </span>
          </div>
          <Heading style="margin: 0; font-size: clamp(28px, 3vw, 44px); font-weight: 600; letter-spacing: -0.03em; line-height: 1.05">
            <a class="lg-stretch" href={localPath(`/work/${p.id}`, locale)}>
              {p.name[locale]}
            </a>
          </Heading>
          <p class="lg-body">{p.context[locale]}</p>
          <span class="lg-link" aria-hidden="true">
            {common.viewProject[locale]}
            <Icon name="arrow" size={18} class="lg-arrow" />
          </span>
        </div>
        {i % 2 === 1 && art}
      </li>
    );
  })}
</ol>
