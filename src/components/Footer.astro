---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { EMAIL, WHATSAPP, engagements, policies, localPath, ui } from "../lib/content.ts";
import type { Locale, Localized } from "../lib/content.ts";
import { footer, nav, common } from "../lib/copy.ts";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const year = new Date().getFullYear();
const L = (p: string) => localPath(p, locale);
const columns: { title: Localized; links: (readonly [string, Localized])[] }[] = [
  { title: nav.solutions, links: engagements.map((e) => [`/solutions/${e.id}`, e.title] as const) },
  {
    title: footer.company,
    links: [
      ["/work", nav.work],
      ["/how-we-work", nav.process],
      ["/about", nav.about],
      ["/faq", nav.faq],
      ["/contact", nav.contact],
    ],
  },
  {
    title: footer.knowledge,
    links: [
      ["/insights", nav.insights],
      ["/resources", nav.resources],
      ["/glossary", nav.glossary],
    ],
  },
  {
    title: footer.policies,
    links: Object.entries(policies).map(([slug, p]) => [`/${slug}`, p.title] as const),
  },
];
---

<footer class="chapter-dark relative overflow-hidden">
  <div class="footer-glow" aria-hidden="true"></div>
  <div class="container-x relative pt-24 pb-10">
    <div class="grid gap-10 border-b border-white/10 pb-16 lg:grid-cols-[1.2fr_1fr] lg:items-end">
      <div>
        <p class="eyebrow mb-5">{nav.contact[locale]}</p>
        <p class="footer-title max-w-xl">{footer.ready[locale]}</p>
      </div>
      <div class="flex flex-wrap gap-3 lg:justify-end">
        <a class="btn btn-light" href={L("/contact") + "?source=/footer"} data-magnetic>
          {ui.cta[locale]}
          <Icon name="arrow" size={18} directional />
        </a>
        {WHATSAPP && (
          <a
            class="btn btn-ghost footer-wa"
            href={`https://wa.me/${WHATSAPP}`}
            rel="noopener"
            target="_blank"
          >
            <Icon name="whatsapp" size={18} />
            {common.whatsapp[locale]}
          </a>
        )}
      </div>
    </div>
    <div class="grid gap-12 pt-16 md:grid-cols-2 lg:grid-cols-[1.3fr_repeat(4,1fr)]">
      <div class="grid content-start gap-5">
        <Logo locale={locale} tone="light" />
        <p class="muted max-w-xs text-[0.95rem]">{footer.tagline[locale]}</p>
        <a class="text-link w-fit text-[0.95rem]" href={`mailto:${EMAIL}`} dir="ltr">
          <Icon name="mail" size={17} />
          {EMAIL}
        </a>
        <p class="muted max-w-xs text-[0.85rem]">{footer.markets[locale]}</p>
      </div>
      {columns.map((col) => (
        <nav aria-label={col.title[locale]} class="grid content-start gap-3">
          <p class="footer-heading">{col.title[locale]}</p>
          {col.links.map(([href, label]) => (
            <a class="footer-link" href={L(href)}>
              {label[locale]}
            </a>
          ))}
        </nav>
      ))}
    </div>
    <div class="mt-16 flex flex-col gap-3 border-t border-white/10 pt-8 text-[0.85rem] text-white/60 md:flex-row md:justify-between">
      <span>© {year} ProHealth Digital LLC</span>
      <span>{footer.disclaimer[locale]}</span>
    </div>
  </div>
</footer>

<style>
  .footer-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.6rem);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-display);
    color: #fff;
    text-wrap: balance;
  }
  .footer-heading {
    margin-block-end: 0.25rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
  }
  :lang(ar) .footer-heading {
    letter-spacing: 0;
    text-transform: none;
    font-size: 0.9rem;
  }
  .footer-link {
    width: fit-content;
    color: #c9d4e8;
    font-size: 0.95rem;
    transition: color var(--dur-fast);
  }
  .footer-link:hover {
    color: #fff;
  }
  .footer-wa {
    --btn-fg: #fff;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.3);
  }
  .footer-glow {
    position: absolute;
    inset-block-start: -40%;
    inset-inline-end: -20%;
    inline-size: 70rem;
    block-size: 50rem;
    background:
      radial-gradient(closest-side, rgb(0 178 169 / 0.18), transparent 70%),
      radial-gradient(closest-side at 30% 60%, rgb(27 78 216 / 0.22), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }
</style>
