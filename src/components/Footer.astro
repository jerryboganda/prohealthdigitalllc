---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import MotionPause from "./MotionPause.astro";
import { EMAIL, WHATSAPP, engagements, policies, localPath, ui } from "../lib/content.ts";
import type { Locale, Localized } from "../lib/content.ts";
import { footer, nav, common, ui2 } from "../lib/copy.ts";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const year = new Date().getFullYear();
const L = (p: string) => localPath(p, locale);
const columns: { title: Localized; links: (readonly [string, Localized])[] }[] = [
  { title: nav.solutions, links: engagements.map((e) => [`/solutions/${e.id}`, e.title] as const) },
  {
    title: footer.company,
    links: [
      ["/work", nav.work],
      ["/how-we-work", nav.process],
      ["/about", nav.about],
      ["/faq", nav.faq],
      ["/contact", nav.contact],
    ],
  },
  {
    title: footer.knowledge,
    links: [
      ["/insights", nav.insights],
      ["/resources", nav.resources],
      ["/glossary", nav.glossary],
    ],
  },
  {
    title: footer.policies,
    links: Object.entries(policies).map(([slug, p]) => [`/${slug}`, p.title] as const),
  },
];
---

<footer class="lg-footer">
  <div class="lg-wrap">
    <div
      class="lg-row"
      style="align-items: center; margin-bottom: clamp(48px, 6vw, 80px)"
      data-reveal
    >
      <p class="lg-h2" style="max-width: 15ch; color: #fff">
        {footer.ready[locale]}
      </p>
      <div style="display: flex; flex-wrap: wrap; gap: 12px">
        <a class="lg-btn lg-btn-w" href={L("/contact") + "?source=footer"} data-magnetic>
          <span>{ui.cta[locale]}</span>
          <span class="lg-btn-ico" aria-hidden="true">
            <Icon name="arrow" size={18} />
          </span>
        </a>
        {WHATSAPP && (
          <a
            class="lg-ghost lg-ghost-w"
            href={`https://wa.me/${WHATSAPP}`}
            rel="noopener"
            target="_blank"
          >
            <Icon name="whatsapp" size={18} />
            {common.whatsapp[locale]}
            <span class="lg-sr">{common.external[locale]}</span>
          </a>
        )}
      </div>
    </div>
    <div style="display: grid; gap: 12px; margin-bottom: 44px; max-width: 46ch">
      <Logo locale={locale} tone="light" />
      <p style="margin: 0; color: var(--mist)">{footer.tagline[locale]}</p>
      <a class="lg-link" href={`mailto:${EMAIL}`} dir="ltr" style="min-height: 36px">
        <Icon name="mail" size={18} />
        {EMAIL}
      </a>
      <p style="margin: 0; font-size: 14px; color: #9aa7c7">{footer.markets[locale]}</p>
    </div>
    <div class="lg-footer-cols">
      {columns.map((col) => (
        <nav class="lg-footer-col" aria-label={col.title[locale]}>
          <p>{col.title[locale]}</p>
          {col.links.map(([href, label]) => (
            <a href={L(href)}>{label[locale]}</a>
          ))}
        </nav>
      ))}
    </div>
    <p class="lg-wordmark" aria-hidden="true" dir="ltr" lang="en" data-reveal-stagger>
      <span>ProHealth</span> <span>Digital</span>
    </p>
    <div class="lg-footer-base">
      <span>
        © {year} ProHealth Digital LLC · {footer.disclaimer[locale]}
      </span>
      <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap">
        <MotionPause locale={locale} />
        <a class="lg-top" href="#main" aria-label={ui2.backToTop[locale]}>
          <Icon name="arrow" size={20} class="-rotate-90" />
        </a>
      </div>
    </div>
  </div>
</footer>
