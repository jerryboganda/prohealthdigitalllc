---
import Icon from "./Icon.astro";
import { engagements, localPath, ui } from "../lib/content.ts";
import type { Engagement, Locale } from "../lib/content.ts";

interface Props {
  locale: Locale;
  filter?: Engagement["audience"];
}
const { locale, filter } = Astro.props;
const icons = {
  "digital-presence": "globe",
  "care-workflows": "flow",
  "platform-launch": "spark",
  "platform-improvement": "layers",
} as const;
const list = engagements.filter((e) => !filter || e.audience === filter);
const all = engagements.map((e) => e.id);
---

<div
  class:list={["grid gap-5", list.length > 2 ? "md:grid-cols-2" : "md:grid-cols-2"]}
  data-reveal-stagger
>
  {list.map((e) => (
    <article class="engagement card card-hover group" data-tilt>
      <div class="engagement-shine" aria-hidden="true" />
      <div class="flex items-start justify-between gap-6">
        <span class="engagement-icon">
          <Icon name={icons[e.id]} size={24} />
        </span>
        <span class="engagement-index" aria-hidden="true">
          0{all.indexOf(e.id) + 1}
        </span>
      </div>
      <p class="eyebrow mt-10">
        {e.audience === "provider" ? ui.providers[locale] : ui.companies[locale]}
      </p>
      <h3 class="mt-3 text-[clamp(1.5rem,1.25rem+1vw,2rem)]">
        <a class="engagement-link" href={localPath(`/solutions/${e.id}`, locale)}>
          {e.title[locale]}
        </a>
      </h3>
      <p class="muted mt-4 max-w-md">{e.problem[locale]}</p>
      <span class="text-link mt-8" aria-hidden="true">
        {ui.explore[locale]}
        <Icon name="arrow" size={18} directional />
      </span>
    </article>
  ))}
</div>

<style>
  .engagement {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    overflow: hidden;
    transform-style: preserve-3d;
  }
  .engagement-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .engagement-icon {
    display: grid;
    place-items: center;
    inline-size: 3.25rem;
    block-size: 3.25rem;
    border-radius: 1rem;
    background: var(--color-mint);
    color: var(--color-teal-700);
    transition:
      background-color var(--dur-base),
      color var(--dur-base),
      rotate var(--dur-slow) var(--ease-out-expo);
  }
  .engagement:hover .engagement-icon {
    background: var(--color-ink);
    color: #fff;
    rotate: -6deg;
  }
  .engagement-index {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--color-muted);
    font-feature-settings: "tnum";
  }
  .engagement-shine {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      28rem circle at var(--px, 50%) var(--py, 0%),
      rgb(0 178 169 / 0.1),
      transparent 45%
    );
    opacity: 0;
    transition: opacity var(--dur-slow);
  }
  .engagement:hover .engagement-shine {
    opacity: 1;
  }
  .engagement:focus-within {
    box-shadow:
      0 0 0 2px var(--color-royal),
      0 30px 60px -30px rgb(10 29 61 / 0.35);
  }
  .engagement-link:focus-visible {
    outline: none;
  }
</style>
