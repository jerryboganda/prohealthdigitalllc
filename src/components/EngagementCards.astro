---
import Icon from "./Icon.astro";
import { engagements, localPath, ui } from "../lib/content.ts";
import type { Engagement, Locale } from "../lib/content.ts";

interface Props {
  locale: Locale;
  filter?: Engagement["audience"];
  level?: "h2" | "h3";
}
const { locale, filter, level = "h3" } = Astro.props;
const Heading = level;
const icons = {
  "digital-presence": "globe",
  "care-workflows": "flow",
  "platform-launch": "spark",
  "platform-improvement": "layers",
} as const;
const list = engagements.filter((e) => !filter || e.audience === filter);
const all = engagements.map((e) => e.id);
---

<div class="lg-grid-4" data-reveal-stagger>
  {list.map((e) => (
    <article class="lg-eng">
      <div style="display: flex; justify-content: space-between; align-items: start">
        <span class="lg-ico" aria-hidden="true">
          <Icon name={icons[e.id]} size={26} />
        </span>
        <span class="lg-num" aria-hidden="true">
          0{all.indexOf(e.id) + 1}
        </span>
      </div>
      <div style="display: grid; gap: 10px">
        <p class="lg-small" style="margin: 0; opacity: 0.8">
          {e.audience === "provider" ? ui.providers[locale] : ui.companies[locale]}
        </p>
        <Heading class="lg-h3">
          <a class="lg-stretch" href={localPath(`/solutions/${e.id}`, locale)}>
            {e.title[locale]}
          </a>
        </Heading>
        <p class="lg-body" style="font-size: 15px">
          {e.problem[locale]}
        </p>
      </div>
      <span class="lg-go" aria-hidden="true">
        <Icon name="arrow" size={18} class="lg-arrow" />
      </span>
    </article>
  ))}
</div>
