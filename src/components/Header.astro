---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { localPath, ui } from "../lib/content.ts";
import type { Locale } from "../lib/content.ts";
import { nav, ui2 } from "../lib/copy.ts";
interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;
const other: Locale = locale === "en" ? "ar" : "en";
const links = [
  ["/solutions", nav.solutions],
  ["/work", nav.work],
  ["/how-we-work", nav.process],
  ["/insights", nav.insights],
  ["/about", nav.about],
] as const;
const mobileLinks = [...links, ["/resources", nav.resources] as const, ["/faq", nav.faq] as const];
const current = (href: string) =>
  path === href || path.startsWith(href + "/") ? "page" : undefined;
const here = localPath(path, locale) + Astro.url.search;
const switchHref = localPath(path, other) + Astro.url.search;
const langHref = (l: Locale) => (l === locale ? here : switchHref);
const contactHref = `${localPath("/contact", locale)}?source=${encodeURIComponent(path)}`;
const langs = [
  ["en", "EN"],
  ["ar", "عربي"],
] as const;
---

<header class="site-header" data-header>
  <div class="lg-bar header-shell">
    <Logo locale={locale} animate />
    <nav aria-label={nav.main[locale]} class="lg-navs lg-hide-md">
      {links.map(([href, label]) => (
        <a class="lg-nav" href={localPath(href, locale)} aria-current={current(href)}>
          {label[locale]}
        </a>
      ))}
    </nav>
    <div class="lg-tools">
      <div class="lg-langs" role="group" aria-label={ui2.language[locale]}>
        {langs.map(([l, label]) => (
          <a
            class="lg-lang"
            href={langHref(l)}
            lang={l}
            hreflang={l}
            aria-current={l === locale ? "true" : undefined}
          >
            {label}
          </a>
        ))}
      </div>
      <a class="lg-btn lg-btn-sm lg-hide-md" href={contactHref} data-magnetic>
        <span>{ui.cta[locale]}</span>
        <span class="lg-btn-ico" aria-hidden="true">
          <Icon name="arrow" size={16} />
        </span>
      </a>
      <button
        type="button"
        class="lg-menu"
        popovertarget="mobile-menu"
        aria-label={nav.openMenu[locale]}
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
  <div id="mobile-menu" popover>
    <div class="lg-sheet-top">
      <Logo locale={locale} tone="light" />
      <button
        type="button"
        class="lg-sheet-close"
        popovertarget="mobile-menu"
        popovertargetaction="hide"
        aria-label={nav.closeMenu[locale]}
        autofocus
      >
        <Icon name="close" size={20} />
      </button>
    </div>
    <nav aria-label={nav.mobile[locale]} class="lg-sheet-links">
      {mobileLinks.map(([href, label], i) => (
        <a href={localPath(href, locale)} aria-current={current(href)} style={`--i:${i}`}>
          <span>{label[locale]}</span>
          <Icon name="arrow" size={22} directional />
        </a>
      ))}
    </nav>
    <div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 32px">
      <a class="lg-btn lg-btn-w" href={contactHref}>
        <span>{ui.cta[locale]}</span>
        <span class="lg-btn-ico" aria-hidden="true">
          <Icon name="arrow" size={18} />
        </span>
      </a>
      <a class="lg-ghost lg-ghost-w" href={switchHref} lang={other} hreflang={other}>
        <Icon name="globe" size={18} />
        {nav.languageName[other]}
      </a>
    </div>
  </div>
</header>

<style>
  /* Menu links rise in sequence each time the sheet opens. */
  @media (prefers-reduced-motion: no-preference) {
    #mobile-menu:popover-open .lg-sheet-links a {
      animation: sheet-link 0.6s var(--ease-out) both;
      animation-delay: calc(0.16s + var(--i, 0) * 0.06s);
    }
  }
  @keyframes sheet-link {
    from {
      opacity: 0;
      translate: 0 18px;
    }
  }
</style>
