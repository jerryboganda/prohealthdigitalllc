---
import { localPath } from "../lib/content.ts";
import type { Locale } from "../lib/content.ts";
import { nav } from "../lib/copy.ts";

export interface Crumb {
  name: string;
  path: string;
}
interface Props {
  locale: Locale;
  trail: Crumb[];
}
const { locale, trail } = Astro.props;
const items = [{ name: nav.home[locale], path: "/" }, ...trail];
---

<nav aria-label={nav.breadcrumbs[locale]}>
  <ol class="lg-crumbs">
    {items.map((item, i) => (
      <li>
        {i < items.length - 1 ? (
          <a href={localPath(item.path, locale)}>{item.name}</a>
        ) : (
          <span aria-current="page" style="color: var(--ink); font-weight: 500">
            {item.name}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
