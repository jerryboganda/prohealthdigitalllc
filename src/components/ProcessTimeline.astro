---
import { stages } from "../lib/content.ts";
import type { Locale } from "../lib/content.ts";

interface Props {
  locale: Locale;
  /** Pin and scroll horizontally on wide screens (motion.ts data-pin-track). */
  pinned?: boolean;
  level?: "h2" | "h3";
  /** "dark" for ink sections, "light" for paper/white sections. */
  tone?: "dark" | "light";
}
const { locale, pinned = false, level = "h3", tone = "dark" } = Astro.props;
const Heading = level;
const nums = ["var(--royal)", "var(--teal)", "var(--mint)", "#fff"];
const numText = ["#fff", "var(--ink)", "var(--ink)", "var(--ink)"];
---

<div
  class:list={["process", tone === "light" && "is-light"]}
  data-pin-track={pinned ? "" : undefined}
>
  {pinned ? (
    <div class="process-bar" aria-hidden="true">
      <span data-track-progress />
    </div>
  ) : (
    <div class="process-line" aria-hidden="true" />
  )}
  <ol class:list={["process-track", pinned && "is-pinned"]} data-track data-reveal-stagger>
    {stages.map((s, i) => (
      <li class="lg-stage process-card">
        <span class="lg-stage-num" style={`background: ${nums[i % 4]}; color: ${numText[i % 4]}`}>
          0{i + 1}
        </span>
        <Heading class="lg-h3">{s.label[locale]}</Heading>
        <p class="lg-body">{s.body[locale]}</p>
      </li>
    ))}
  </ol>
</div>

<style>
  .process {
    position: relative;
  }
  .process-track {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .process-card {
    padding: 28px;
    border-radius: var(--r-lg);
    border: 1px solid rgb(255 255 255 / 0.14);
    background: rgb(255 255 255 / 0.04);
    transition:
      border-color var(--t-base),
      background var(--t-base);
  }
  .process-card:hover {
    border-color: rgb(94 234 212 / 0.5);
    background: rgb(255 255 255 / 0.07);
  }
  .is-light .process-card {
    border-color: var(--line);
    background: #fff;
  }
  .is-light .process-card:hover {
    border-color: var(--line-2);
  }
  .process-bar,
  .process-line {
    height: 3px;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.16);
    margin-block-end: 28px;
    overflow: hidden;
  }
  .is-light :is(.process-bar, .process-line) {
    background: var(--line);
  }
  .process-line {
    background: linear-gradient(90deg, var(--royal), var(--teal), var(--mint));
  }
  [dir="rtl"] .process-line {
    background: linear-gradient(-90deg, var(--royal), var(--teal), var(--mint));
  }
  .process-bar span {
    display: block;
    block-size: 100%;
    background: var(--mint);
    transform-origin: left;
  }
  [dir="rtl"] .process-bar span {
    transform-origin: right;
  }
  .is-light .process-bar span {
    background: var(--royal);
  }
  /* Horizontal only while motion.ts pins it (motion allowed, "wide" query in pinTracks);
     otherwise the grid keeps every stage on screen. */
  @media (min-width: 1100px) and (prefers-reduced-motion: no-preference) {
    :global(html.motion-ready) .is-pinned {
      display: flex;
      inline-size: max-content;
    }
    :global(html.motion-ready) .is-pinned > li {
      inline-size: 420px;
      min-block-size: 300px;
    }
  }
  @media (max-width: 1099px) {
    .process-track {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .process-track {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
