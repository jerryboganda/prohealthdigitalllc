---
import Breadcrumbs from "./Breadcrumbs.astro";
import type { Crumb } from "./Breadcrumbs.astro";
import ArtGrid from "./ArtGrid.astro";
import type { Locale } from "../lib/content.ts";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  eyebrow?: string;
  trail?: Crumb[];
  tone?: "paper" | "mint";
  /** Living-grid art on the inline-end side (default) or none for editorial pages. */
  art?: "grid" | "small" | "none";
}
const {
  locale,
  title,
  description,
  eyebrow,
  trail = [],
  tone = "paper",
  art = "grid",
} = Astro.props;
---

<section
  class:list={["lg-wrap", tone === "mint" && "lg-tint"]}
  style="padding-top: clamp(24px, 4vw, 56px); padding-bottom: clamp(48px, 6vw, 88px)"
>
  {trail.length > 0 && (
    <div class="lg-in">
      <Breadcrumbs locale={locale} trail={trail} />
    </div>
  )}
  <div class="lg-row" style="align-items: center; gap: 40px; margin-top: clamp(28px, 4vw, 52px)">
    <div class="lg-stack" style="gap: 22px; flex: 999 1 560px; min-width: 0">
      {eyebrow && (
        <p class="lg-eyebrow lg-in">
          <span class="lg-dot" aria-hidden="true" />
          {eyebrow}
        </p>
      )}
      <h1 class="lg-h1-page lg-in-solid lg-d1" style="max-width: 18ch">
        {title}
      </h1>
      <p class="lg-lede lg-in lg-d2">{description}</p>
      <div class="lg-in lg-d3">
        <slot />
      </div>
    </div>
    {art !== "none" && (
      <div
        class="lg-in lg-d3 intro-art"
        style="flex: 1 1 260px; display: flex; justify-content: center"
      >
        <ArtGrid size={art === "small" ? "sm" : "lg"} motion="float" style="max-width: 340px" />
      </div>
    )}
  </div>
</section>

<style>
  /* On phones the art is an accent, not a block that pushes content below the fold. */
  @media (max-width: 600px) {
    .intro-art {
      justify-content: flex-start !important;
      max-width: 168px;
    }
  }
</style>
