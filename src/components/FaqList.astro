---
import type { Locale, Localized } from "../lib/content.ts";

interface Props {
  locale: Locale;
  items: { q: Localized; a: Localized }[];
  /** Open the first answer by default. */
  openFirst?: boolean;
}
const { locale, items, openFirst = true } = Astro.props;
---

<div data-reveal>
  {items.map((item, i) => (
    <details class="lg-acc" open={openFirst && i === 0}>
      <summary>
        {item.q[locale]}
        <span class="lg-acc-ico" aria-hidden="true" />
      </summary>
      <div class="lg-acc-body">{item.a[locale]}</div>
    </details>
  ))}
</div>
