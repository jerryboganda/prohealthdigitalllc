---
interface Props {
  eyebrow?: string;
  title: string;
  body?: string;
  align?: "start" | "center";
  id?: string;
  class?: string;
  as?: "h1" | "h2";
  /** Dot colour for the eyebrow. */
  dot?: "teal" | "royal" | "mint";
}
const {
  eyebrow,
  title,
  body,
  align = "start",
  id,
  class: className,
  as: Tag = "h2",
  dot = "royal",
} = Astro.props;
const dotColor = {
  teal: undefined,
  royal: "background: var(--royal)",
  mint: "background: var(--mint)",
}[dot];
---

<div
  class:list={["lg-stack", className]}
  style={`gap: 16px; max-width: 820px;${align === "center" ? " margin-inline: auto; text-align: center; justify-items: center;" : ""}`}
  data-reveal
>
  {eyebrow && (
    <p class="lg-eyebrow">
      <span class="lg-dot" aria-hidden="true" style={dotColor} />
      {eyebrow}
    </p>
  )}
  <Tag class="lg-h2" id={id} data-split>
    {title}
  </Tag>
  {body && <p class="lg-lede">{body}</p>}
  <slot />
</div>
