---
import PageIntro from "../components/PageIntro.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProcessTimeline from "../components/ProcessTimeline.astro";
import Marquee from "../components/Marquee.astro";
import FaqList from "../components/FaqList.astro";
import CtaBand from "../components/CtaBand.astro";
import ArtGrid from "../components/ArtGrid.astro";
import Icon from "../components/Icon.astro";
import { faqs, localPath, policies, stages, ui } from "../lib/content.ts";
import type { Locale } from "../lib/content.ts";
import { home, nav, pages } from "../lib/copy.ts";
import { companyUi, sentences } from "../lib/copy-company.ts";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (p: string) => localPath(p, locale);
const contact = `${L("/contact")}?source=/how-we-work`;
// ponytail: indices follow the sentence order of the delivery policy (same in EN and AR); recheck if it is rewritten.
const delivery = sentences(policies.delivery.sections[0].body[locale]);
const expect = [
  { body: companyUi.followup[locale], link: faqs[6].q[locale], href: L("/faq") },
  { body: home.principles[0].body[locale], link: pages.proposalTitle[locale], href: "#proposal" },
  {
    body: delivery.slice(0, 2).join(" "),
    link: policies.delivery.title[locale],
    href: L("/delivery"),
  },
  {
    body: `${home.principles[3].body[locale]} ${delivery[3]}`,
    link: ui.support[locale],
    href: "#support",
  },
];
const numLook = [
  undefined,
  "background: var(--teal); color: var(--ink)",
  "background: var(--ink)",
  "background: var(--mint); color: var(--ink)",
];
const faqItems = [1, 6, 2, 3, 4].map((i) => faqs[i]);
---

<PageIntro
  locale={locale}
  eyebrow={nav.process[locale]}
  title={pages.processTitle[locale]}
  description={ui.discoveryBody[locale]}
  trail={[{ name: nav.process[locale], path: "/how-we-work" }]}
>
  <div style="display: flex; flex-wrap: wrap; gap: 12px">
    <a class="lg-btn" href={contact} data-magnetic>
      <span>{ui.cta[locale]}</span>
      <span class="lg-btn-ico" aria-hidden="true">
        <Icon name="arrow" size={18} />
      </span>
    </a>
    <a class="lg-ghost" href="#process">
      {home.processLink[locale]}
    </a>
  </div>
</PageIntro>

<section id="process" class="lg-section lg-ink" style="position: relative; overflow: hidden">
  <div
    aria-hidden="true"
    data-parallax="0.06"
    style="position: absolute; inset: -60px 0; background-image: radial-gradient(rgb(255 255 255 / 0.14) 1.2px, transparent 1.6px); background-size: 26px 26px"
  ></div>
  <ArtGrid
    motion="spin"
    cells={[undefined, undefined, undefined, undefined, "var(--mint)"]}
    style="position: absolute; inset-inline-end: -140px; top: -140px; width: 420px; opacity: 0.1; animation-duration: 90s"
  />
  <div class="lg-wrap" style="position: relative; display: grid; gap: clamp(48px, 6vw, 88px)">
    <div class="lg-row">
      <SectionHeading eyebrow={home.note[locale]} title={home.processTitle[locale]} dot="mint" />
      <a class="lg-ghost" href={contact}>
        {ui.cta[locale]}
      </a>
    </div>
    <ProcessTimeline locale={locale} />
    <div aria-hidden="true">
      <Marquee locale={locale} items={stages.map((s) => s.label)} rows={1} />
    </div>
  </div>
</section>

<section class="lg-section lg-white">
  <div class="lg-wrap lg-split">
    <div class="lg-stack lg-sticky" style="gap: 20px">
      <SectionHeading
        eyebrow={nav.process[locale]}
        title={pages.expectTitle[locale]}
        body={pages.expectA[locale]}
      />
      <ArtGrid size="sm" motion="float" style="margin-top: 12px" />
    </div>
    <ol style="margin: 0; padding: 0; list-style: none; display: grid; gap: 16px">
      {stages.map((s, i) => (
        <li
          class="lg-card lg-stage"
          data-reveal="side"
          style="grid-template-columns: auto minmax(0, 1fr); gap: 22px; align-items: start; padding: clamp(24px, 3vw, 36px)"
        >
          <span class="lg-stage-num" aria-hidden="true" style={numLook[i]}>
            0{i + 1}
          </span>
          <div class="lg-stack" style="gap: 10px">
            <h3 class="lg-h3">{s.label[locale]}</h3>
            <p class="lg-body">{expect[i].body}</p>
            <a class="lg-link" href={expect[i].href}>
              {expect[i].link}
              <Icon name="arrow" size={18} class="lg-arrow" />
            </a>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section id="proposal" class="lg-section lg-tint">
  <div class="lg-wrap lg-split">
    <SectionHeading
      class="lg-sticky"
      eyebrow={stages[1].label[locale]}
      title={pages.proposalTitle[locale]}
      body={ui.scope[locale]}
    />
    <ul style="margin: 0; padding: 0; list-style: none; display: grid; gap: 12px">
      {pages.proposalItems.map((item, i) => (
        <li
          class="lg-card"
          data-reveal="side"
          style="grid-template-columns: auto minmax(0, 1fr) auto; gap: 20px; align-items: center; padding: 20px 24px"
        >
          <span class="lg-num" aria-hidden="true" style="font-size: 16px; color: var(--teal-ink)">
            {String(i + 1).padStart(2, "0")}
          </span>
          <span style="font-size: 17px; font-weight: 500">{item[locale]}</span>
          <span class="lg-box" aria-hidden="true" style={`animation-delay: ${i * 0.4}s`}>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#fff"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                class="lg-check"
                style={`animation-delay: ${i * 0.4}s`}
                d="M5 12.5l4.5 4.5L19 7.5"
              />
            </svg>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="lg-section">
  <div class="lg-wrap" data-reveal="scale">
    <div class="lg-bento">
      <div
        id="support"
        class="lg-tile lg-tile-ink lg-span2 lg-shine"
        style="min-height: 400px; padding: clamp(28px, 4vw, 52px)"
      >
        <div class="lg-stack" style="gap: 18px; max-width: 62ch">
          <p class="lg-eyebrow" style="color: var(--mist)">
            <span class="lg-dot" aria-hidden="true" style="background: var(--mint)"></span>
            24/7
          </p>
          <h2 class="lg-h2" style="max-width: 15ch" data-split>
            {ui.support[locale]}
          </h2>
          <p class="lg-body" style="font-size: 18px; color: var(--mist)">
            {ui.supportBody[locale]}
          </p>
        </div>
        <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 20px">
          <a class="lg-link" href={L("/faq")}>
            {faqs[4].q[locale]}
            <Icon name="arrow" size={18} class="lg-arrow" />
          </a>
          <svg viewBox="0 0 240 60" width="100%" style="max-width: 300px" aria-hidden="true">
            <path
              class="lg-check"
              pathLength="24"
              d="M2 32h72l12-22 18 44 14-34 10 12h110"
              fill="none"
              stroke="#5eead4"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </div>
      </div>
      <div class="lg-tile lg-tile-teal">
        <p class="lg-tile-title">{home.marquee[6][locale]}</p>
        <svg
          width="140"
          height="140"
          viewBox="0 0 120 120"
          aria-hidden="true"
          style="justify-self: center"
        >
          <circle
            cx="60"
            cy="60"
            r="52"
            fill="#fff"
            stroke="rgb(10 20 51 / 0.12)"
            stroke-width="2"
          ></circle>
          <circle
            cx="60"
            cy="60"
            r="52"
            fill="none"
            stroke="#007a72"
            stroke-width="2"
            stroke-dasharray="3 10.6"
          ></circle>
          <line
            class="lg-hand-h"
            x1="60"
            y1="60"
            x2="60"
            y2="32"
            stroke="#0a1433"
            stroke-width="4"
            stroke-linecap="round"
          ></line>
          <line
            class="lg-hand-m"
            x1="60"
            y1="60"
            x2="60"
            y2="18"
            stroke="#1f4fe0"
            stroke-width="3"
            stroke-linecap="round"
          ></line>
          <circle cx="60" cy="60" r="5" fill="#0a1433"></circle>
        </svg>
        <p style="margin: 0; font-size: 15px; color: var(--ink-2)">{faqs[4].a[locale]}</p>
      </div>
    </div>
  </div>
</section>

<section class="lg-section lg-white">
  <div class="lg-wrap lg-split">
    <SectionHeading
      class="lg-sticky"
      eyebrow={nav.faq[locale]}
      title={pages.faqTitle[locale]}
      body={pages.faqBody[locale]}
      dot="teal"
    >
      <a class="lg-link" href={L("/faq")}>
        {nav.faq[locale]}
        <Icon name="arrow" size={18} class="lg-arrow" />
      </a>
    </SectionHeading>
    <FaqList locale={locale} items={faqItems} />
  </div>
</section>

<CtaBand locale={locale} source="/how-we-work" />
