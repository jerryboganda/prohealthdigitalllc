---
import PageIntro from "../components/PageIntro.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SolEngagementCard from "../components/SolEngagementCard.astro";
import Marquee from "../components/Marquee.astro";
import ArtGrid from "../components/ArtGrid.astro";
import CtaBand from "../components/CtaBand.astro";
import ArticleCard from "../components/ArticleCard.astro";
import Icon from "../components/Icon.astro";
import { audiences } from "../lib/audiences.ts";
import { engagements, localPath, ui } from "../lib/content.ts";
import type { Locale } from "../lib/content.ts";
import { common, home, nav } from "../lib/copy.ts";
import { entriesFor } from "../site/collections.ts";

interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const L = (p: string) => localPath(p, locale);
const ar = locale === "ar";
const a = audiences.find((x) => x.id === slug)!;
const isProvider = a.id === "providers";
// Audience-specific entries before "both" (sort is stable); one slot is reserved for a resource.
const own = (e: { data: { audience: string } }) => (e.data.audience === a.id ? 0 : 1);
const resources = (await entriesFor("resources", locale))
  .filter((e) => e.data.audience === a.id || e.data.audience === "both")
  .sort((x, y) => own(x) - own(y))
  .slice(0, 1);
const reading = (await entriesFor("insights", locale))
  .filter((e) => e.data.audience === a.id || e.data.audience === "both")
  .sort((x, y) => own(x) - own(y))
  .slice(0, 3 - resources.length);
const icons = ["globe", "mail", "flow", "book"] as const;
// Bento look per challenge: tile colour, whether it spans two columns, number colour.
const tiles = [
  { tile: "lg-tile-royal lg-shine", span: true, num: "var(--royal-100)" },
  { tile: "lg-tile-teal", span: false, num: "var(--teal-strong)" },
  { tile: "lg-tile-white", span: false, num: undefined },
  { tile: "lg-tile-ink lg-shine", span: true, num: "var(--mint)" },
];
const stageNums = [
  "",
  "background: var(--teal); color: var(--ink)",
  "background: var(--mint); color: var(--ink)",
  "background: #fff; color: var(--ink)",
];
const glyphs = ar ? ["أب", "Aa"] : ["Aa", "أب"];
---

<PageIntro
  locale={locale}
  eyebrow={a.eyebrow[locale]}
  title={a.title[locale]}
  description={a.intro[locale]}
  trail={[{ name: a.eyebrow[locale], path: `/${a.id}` }]}
>
  <div class="lg-stack" style="gap: 22px">
    <p
      class="lg-body"
      style="display: flex; gap: 12px; align-items: start; max-width: 62ch; font-size: 15px"
    >
      <Icon name={isProvider ? "pulse" : "layers"} size={20} class="aud-who-ico" />
      <span>{a.who[locale]}</span>
    </p>
    <div style="display: flex; flex-wrap: wrap; gap: 12px">
      <a class="lg-btn" href={`${L("/contact")}?source=/${a.id}`} data-magnetic>
        <span>{ui.cta[locale]}</span>
        <span class="lg-btn-ico" aria-hidden="true">
          <Icon name="arrow" size={18} />
        </span>
      </a>
      <a class="lg-ghost" href="#solutions">
        {(isProvider ? home.exploreProviders : home.exploreCompanies)[locale]}
      </a>
    </div>
  </div>
</PageIntro>

<div style="padding-block: 0 clamp(32px, 4vw, 56px)">
  <Marquee locale={locale} items={home.marquee} />
</div>

<section class="lg-section lg-white">
  <div class="lg-wrap" style="display: grid; gap: 48px">
    <SectionHeading eyebrow={a.eyebrow[locale]} title={a.challengesTitle[locale]} dot="teal" />
    <ul class="lg-bento" style="margin: 0; padding: 0; list-style: none">
      {a.challenges.map((c, i) => {
        const look = tiles[i % tiles.length];
        return (
          <li class:list={[look.span && "lg-span2"]} data-reveal="scale" style="display: grid">
            <article class:list={["lg-tile", look.tile]} data-tilt={look.span ? undefined : ""}>
              <div style="display: flex; justify-content: space-between; align-items: start; gap: 16px">
                <span
                  class="lg-ico"
                  aria-hidden="true"
                  style={
                    i === 1
                      ? "background: #fff; color: var(--teal-ink)"
                      : i === 3
                        ? "background: rgb(255 255 255 / 0.1); color: var(--mint)"
                        : undefined
                  }
                >
                  <Icon name={icons[i % icons.length]} size={26} />
                </span>
                {i === 0 && (
                  <ArtGrid
                    size="sm"
                    motion="spin"
                    class="aud-tile-art"
                    cells={[
                      "#fff",
                      "rgb(255 255 255 / 0.3)",
                      "var(--mint)",
                      "rgb(255 255 255 / 0.3)",
                      "#fff",
                      "rgb(255 255 255 / 0.3)",
                      "var(--mint)",
                      "rgb(255 255 255 / 0.3)",
                      "#fff",
                    ]}
                  />
                )}
                {i === 3 &&
                  (isProvider ? (
                    <div style="display: flex; align-items: center; gap: 14px" aria-hidden="true">
                      <Icon name="arrow" size={26} class="lg-dir aud-mint" />
                      <div class="lg-flip" style="width: 150px; height: 92px">
                        <span
                          class="lg-flipA aud-glyph"
                          lang={ar ? "ar" : "en"}
                          style={ar ? undefined : "letter-spacing: -0.04em"}
                        >
                          {glyphs[0]}
                        </span>
                        <span class="lg-flipB aud-glyph" lang={ar ? "en" : "ar"}>
                          {glyphs[1]}
                        </span>
                      </div>
                    </div>
                  ) : (
                    <ArtGrid
                      size="sm"
                      motion="float"
                      class="aud-tile-art"
                      cells={[undefined, undefined, undefined, undefined, "var(--mint)"]}
                    />
                  ))}
              </div>
              <div class:list={["aud-tile-copy", `is-${i % 4}`]}>
                <span class="lg-num" style={look.num && `color: ${look.num}`}>
                  0{i + 1}
                </span>
                <h3 class:list={[look.span ? "aud-tile-h" : "lg-tile-title"]}>{c.title[locale]}</h3>
                <p>{c.body[locale]}</p>
              </div>
            </article>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<section class="lg-section lg-tint" id="solutions">
  <div class="lg-wrap" style="display: grid; gap: 48px">
    <div class="lg-row">
      <SectionHeading eyebrow={nav.solutions[locale]} title={a.eyebrow[locale]} />
      <a class="lg-link" href={L("/solutions")}>
        {nav.solutions[locale]}
        <Icon name="arrow" size={18} class="lg-arrow" />
      </a>
    </div>
    <div class="lg-grid-2">
      {engagements
        .filter((e) => e.audience === a.engagement)
        .map((e) => (
          <SolEngagementCard locale={locale} engagement={e} />
        ))}
    </div>
  </div>
</section>

<section class="lg-section lg-ink" style="position: relative; overflow: hidden">
  <div
    aria-hidden="true"
    data-parallax="0.06"
    style="position: absolute; inset: -80px 0; background-image: radial-gradient(rgb(255 255 255 / 0.14) 1.2px, transparent 1.6px); background-size: 26px 26px"
  ></div>
  <div class="lg-wrap lg-split" style="position: relative">
    <SectionHeading
      class="lg-sticky"
      eyebrow={a.eyebrow[locale]}
      title={a.approachTitle[locale]}
      dot="mint"
    >
      <div
        class="lg-tile lg-tile-royal lg-shine"
        style="min-height: 0; gap: 14px; align-content: start; margin-top: 4px"
      >
        <h3 class="lg-tile-title">{a.startTitle[locale]}</h3>
        <p style="margin: 0; line-height: 1.65; color: #e6ecff">{a.start[locale]}</p>
      </div>
    </SectionHeading>
    <ol style="margin: 0; padding: 0; list-style: none; display: grid; gap: 16px">
      {a.approach.map((step, i) => (
        <li class="lg-card lg-card-ink lg-stage aud-step" data-reveal="side">
          <span class="lg-stage-num" aria-hidden="true" style={stageNums[i % 4]}>
            {String(i + 1).padStart(2, "0")}
          </span>
          <p>{step[locale]}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

{(reading.length > 0 || resources.length > 0) && (
  <section class="lg-section">
    <div class="lg-wrap" style="display: grid; gap: 44px">
      <div class="lg-row">
        <SectionHeading title={common.relatedReading[locale]} />
        <a class="lg-link" href={L("/insights")}>
          {common.allInsights[locale]}
          <Icon name="arrow" size={18} class="lg-arrow" />
        </a>
      </div>
      <div class="lg-grid-3" data-reveal-stagger>
        {reading.map((e, i) => (
          <ArticleCard
            locale={locale}
            href={`/insights/${e.slug}`}
            title={e.data.title}
            description={e.data.description}
            label={nav.insights[locale]}
            date={e.data.published}
            index={i}
          />
        ))}
        {resources.map((e, i) => (
          <ArticleCard
            locale={locale}
            href={`/resources/${e.slug}`}
            title={e.data.title}
            description={e.data.description}
            label={nav.resources[locale]}
            cta={common.openResource[locale]}
            index={reading.length + i}
          />
        ))}
      </div>
    </div>
  </section>
)}

<CtaBand locale={locale} source={`/${a.id}`} />

<style>
  :global(.aud-who-ico) {
    flex: none;
    margin-top: 3px;
    color: var(--teal-ink);
  }
  :global(.aud-tile-art) {
    width: 96px;
    gap: 5px;
    animation-duration: 30s;
  }
  :global(.aud-mint) {
    color: var(--mint);
  }
  .aud-glyph {
    font-size: 72px;
    color: var(--mint);
  }
  .aud-tile-copy {
    display: grid;
    gap: 12px;
  }
  .aud-tile-copy p {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    max-width: 54ch;
  }
  .aud-tile-copy p:lang(ar) {
    line-height: 1.9;
  }
  .aud-tile-copy.is-0 p {
    color: #e6ecff;
  }
  .aud-tile-copy.is-1 p {
    color: var(--ink-2);
  }
  .aud-tile-copy.is-2 p {
    color: var(--muted);
  }
  .aud-tile-copy.is-3 p {
    color: var(--mist);
  }
  .aud-tile-h {
    margin: 0;
    font-size: clamp(26px, 2.6vw, 36px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  .aud-tile-h:lang(ar) {
    line-height: 1.45;
  }
  .aud-step {
    grid-template-columns: auto minmax(0, 1fr);
    gap: 22px;
    align-items: center;
    border-color: rgb(255 255 255 / 0.16);
    background: rgb(255 255 255 / 0.04);
  }
  .aud-step p {
    margin: 0;
    font-size: clamp(17px, 1.4vw, 20px);
    line-height: 1.55;
    color: #fff;
  }
  .aud-step p:lang(ar) {
    line-height: 1.85;
  }
</style>
