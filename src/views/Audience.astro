---
import PageIntro from "../components/PageIntro.astro";
import SectionHeading from "../components/SectionHeading.astro";
import EngagementCards from "../components/EngagementCards.astro";
import CtaBand from "../components/CtaBand.astro";
import ArticleCard from "../components/ArticleCard.astro";
import Icon from "../components/Icon.astro";
import { audiences } from "../lib/audiences.ts";
import { localPath } from "../lib/content.ts";
import type { Locale } from "../lib/content.ts";
import { nav, common } from "../lib/copy.ts";
import { entriesFor } from "../site/collections.ts";

interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const a = audiences.find((x) => x.id === slug)!;
// Audience-specific entries before "both" (sort is stable); one slot is reserved for a resource.
const own = (e: { data: { audience: string } }) => (e.data.audience === a.id ? 0 : 1);
const resources = (await entriesFor("resources", locale))
  .filter((e) => e.data.audience === a.id || e.data.audience === "both")
  .sort((x, y) => own(x) - own(y))
  .slice(0, 1);
const reading = (await entriesFor("insights", locale))
  .filter((e) => e.data.audience === a.id || e.data.audience === "both")
  .sort((x, y) => own(x) - own(y))
  .slice(0, 3 - resources.length);
const icons = ["globe", "mail", "flow", "book"] as const;
---

<PageIntro
  locale={locale}
  eyebrow={a.eyebrow[locale]}
  title={a.title[locale]}
  description={a.intro[locale]}
  trail={[{ name: a.eyebrow[locale], path: `/${a.id}` }]}
  tone="mint"
>
  <p class="muted max-w-2xl text-[0.97rem]">{a.who[locale]}</p>
</PageIntro>

<section class="section">
  <div class="container-x grid gap-14">
    <SectionHeading title={a.challengesTitle[locale]} />
    <div class="grid gap-5 md:grid-cols-2" data-reveal-stagger>
      {a.challenges.map((c, i) => (
        <article class="challenge card">
          <span class="challenge-icon">
            <Icon name={icons[i % icons.length]} size={22} />
          </span>
          <h3>{c.title[locale]}</h3>
          <p class="muted">{c.body[locale]}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section bg-mint/60">
  <div class="container-x grid gap-12">
    <SectionHeading eyebrow={nav.solutions[locale]} title={a.eyebrow[locale]} />
    <EngagementCards locale={locale} filter={a.engagement} />
  </div>
</section>

<section class="section">
  <div class="container-x grid gap-14 lg:grid-cols-[0.9fr_1.1fr]">
    <SectionHeading title={a.approachTitle[locale]}>
      <div class="card mt-4 grid gap-3 p-7" data-reveal>
        <h3 class="text-[1.3rem]">{a.startTitle[locale]}</h3>
        <p class="muted">{a.start[locale]}</p>
      </div>
    </SectionHeading>
    <ol class="grid gap-3" data-reveal-stagger>
      {a.approach.map((step, i) => (
        <li class="approach">
          <span class="approach-num" aria-hidden="true">
            {String(i + 1).padStart(2, "0")}
          </span>
          <span>{step[locale]}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

{(reading.length > 0 || resources.length > 0) && (
  <section class="section-tight">
    <div class="container-x grid gap-10">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="text-[clamp(1.6rem,1.3rem+1.2vw,2.3rem)]">{common.relatedReading[locale]}</h2>
        <a class="text-link" href={localPath("/insights", locale)}>
          {common.allInsights[locale]}
          <Icon name="arrow" size={18} directional />
        </a>
      </div>
      <div class="grid gap-5 md:grid-cols-3" data-reveal-stagger>
        {reading.map((e, i) => (
          <ArticleCard
            locale={locale}
            href={`/insights/${e.slug}`}
            title={e.data.title}
            description={e.data.description}
            label={nav.insights[locale]}
            date={e.data.published}
            index={i}
          />
        ))}
        {resources.map((e, i) => (
          <ArticleCard
            locale={locale}
            href={`/resources/${e.slug}`}
            title={e.data.title}
            description={e.data.description}
            label={nav.resources[locale]}
            index={reading.length + i}
          />
        ))}
      </div>
    </div>
  </section>
)}

<CtaBand locale={locale} source={`/${a.id}`} />

<style>
  .challenge {
    display: grid;
    gap: 0.85rem;
    align-content: start;
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
  }
  .challenge h3 {
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.7rem);
  }
  .challenge-icon {
    display: grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: 0.9rem;
    background: var(--color-mint);
    color: var(--color-teal-700);
  }
  .approach {
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
    padding: 1.25rem 1.4rem;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 0 0 1px var(--color-line);
    font-size: 1.05rem;
  }
  .approach-num {
    font-family: var(--font-display);
    color: var(--color-teal-700);
  }
</style>
