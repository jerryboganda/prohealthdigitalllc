---
import Icon from "../components/Icon.astro";
import HeroCanvas from "../components/HeroCanvas.astro";
import JourneyCard from "../components/JourneyCard.astro";
import Marquee from "../components/Marquee.astro";
import SectionHeading from "../components/SectionHeading.astro";
import EngagementCards from "../components/EngagementCards.astro";
import ProjectList from "../components/ProjectList.astro";
import ProcessTimeline from "../components/ProcessTimeline.astro";
import FaqList from "../components/FaqList.astro";
import CtaBand from "../components/CtaBand.astro";
import ArticleCard from "../components/ArticleCard.astro";
import LineMotif from "../components/LineMotif.astro";
import { faqs, localPath, ui } from "../lib/content.ts";
import type { Locale } from "../lib/content.ts";
import { home, nav, common } from "../lib/copy.ts";
import { entriesFor } from "../site/collections.ts";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const L = (p: string) => localPath(p, locale);
const insights = (await entriesFor("insights", locale)).slice(0, 3);
const audienceLabel = (a: string) =>
  a === "providers"
    ? common.forProviders[locale]
    : a === "digital-health-companies"
      ? common.forCompanies[locale]
      : common.forBoth[locale];
---

<section class="home-hero relative isolate overflow-hidden">
  <HeroCanvas />
  <div class="container-x grid min-h-[calc(100svh-var(--header-h))] items-center gap-14 py-16 lg:grid-cols-[1.25fr_0.9fr] lg:py-24">
    <div class="hero-enter grid gap-7">
      <p class="eyebrow">{home.eyebrow[locale]}</p>
      <h1 class="display max-w-[14ch] rtl:max-w-[16ch]">
        {home.titleA[locale]} <em>{home.titleEm[locale]}</em>
        {home.titleB[locale]}
      </h1>
      <p class="lede">{ui.intro[locale]}</p>
      <div class="flex flex-wrap items-center gap-4">
        <a class="btn" href={`${L("/contact")}?source=/`} data-magnetic>
          {ui.cta[locale]}
          <Icon name="arrow" size={18} directional />
        </a>
        <a class="btn btn-ghost" href={L("/solutions")}>
          {home.secondaryCta[locale]}
        </a>
      </div>
      <p class="hero-note">
        <span class="pulse-dot" aria-hidden="true"></span>
        {home.note[locale]}
      </p>
    </div>
    <div class="relative">
      <JourneyCard locale={locale} />
    </div>
  </div>
</section>

<Marquee locale={locale} items={home.marquee} pauseLabel={home.marqueePause[locale]} />

<section class="section relative overflow-hidden">
  <div class="container-x grid gap-16">
    <SectionHeading eyebrow={nav.solutions[locale]} title={home.audienceTitle[locale]} />
    <div class="grid gap-5 md:grid-cols-2" data-reveal-stagger>
      <a class="audience card card-hover group" href={L("/providers")}>
        <span class="audience-glyph" aria-hidden="true">
          <Icon name="pulse" size={30} />
        </span>
        <p class="eyebrow">{ui.providers[locale]}</p>
        <h3 class="audience-title">{ui.providerIntro[locale]}</h3>
        <span class="text-link w-fit">
          {home.exploreProviders[locale]}
          <Icon name="arrow" size={18} directional />
        </span>
      </a>
      <a class="audience audience-dark card card-hover group" href={L("/digital-health-companies")}>
        <span class="audience-glyph" aria-hidden="true">
          <Icon name="layers" size={30} />
        </span>
        <p class="eyebrow">{ui.companies[locale]}</p>
        <h3 class="audience-title">{ui.companyIntro[locale]}</h3>
        <span class="text-link w-fit">
          {home.exploreCompanies[locale]}
          <Icon name="arrow" size={18} directional />
        </span>
      </a>
    </div>
  </div>
</section>

<section class="section bg-mint/60 relative">
  <div class="container-x grid gap-14">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <SectionHeading title={home.problemTitle[locale]} body={home.problemBody[locale]} />
      <a class="text-link" href={L("/solutions")}>
        {nav.solutions[locale]}
        <Icon name="arrow" size={18} directional />
      </a>
    </div>
    <EngagementCards locale={locale} />
  </div>
</section>

<section class="section">
  <div class="container-x grid gap-14">
    <SectionHeading
      eyebrow={ui.work[locale]}
      title={home.workTitle[locale]}
      body={ui.proofNote[locale]}
    />
    <ProjectList locale={locale} />
  </div>
</section>

<section class="section chapter-dark relative overflow-hidden">
  <div class="dark-glow" aria-hidden="true"></div>
  <div class="container-x relative grid gap-14">
    <SectionHeading eyebrow={ui.process[locale]} title={home.processTitle[locale]} />
    <ProcessTimeline locale={locale} pinned />
    <a class="text-link w-fit" href={L("/how-we-work")}>
      {home.processLink[locale]}
      <Icon name="arrow" size={18} directional />
    </a>
  </div>
</section>

<section class="section">
  <div class="container-x grid gap-16 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="grid content-start gap-8 lg:sticky lg:top-28">
      <SectionHeading
        eyebrow={ui.support[locale]}
        title={home.principlesTitle[locale]}
        body={ui.supportBody[locale]}
      />
      <LineMotif variant="flow" class="h-20 w-full opacity-80" />
    </div>
    <ol class="grid gap-4" data-reveal-stagger>
      {home.principles.map((p, i) => (
        <li class="principle card">
          <span class="principle-num" aria-hidden="true">
            {String(i + 1).padStart(2, "0")}
          </span>
          <div class="grid gap-2">
            <h3>{p.title[locale]}</h3>
            <p class="muted">{p.body[locale]}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

{insights.length > 0 && (
  <section class="section bg-mint/50">
    <div class="container-x grid gap-14">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <SectionHeading
          eyebrow={nav.insights[locale]}
          title={home.insightsTitle[locale]}
          body={home.insightsBody[locale]}
        />
        <a class="text-link" href={L("/insights")}>
          {common.allInsights[locale]}
          <Icon name="arrow" size={18} directional />
        </a>
      </div>
      <div class="grid gap-5 md:grid-cols-3" data-reveal-stagger>
        {insights.map((entry, i) => (
          <ArticleCard
            locale={locale}
            href={`/insights/${entry.slug}`}
            title={entry.data.title}
            description={entry.data.description}
            label={audienceLabel(entry.data.audience)}
            date={entry.data.published}
            index={i}
          />
        ))}
      </div>
    </div>
  </section>
)}

<section class="section">
  <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
    <SectionHeading eyebrow={nav.faq[locale]} title={home.faqTitle[locale]}>
      <a class="text-link mt-2 w-fit" href={L("/faq")}>
        {nav.faq[locale]}
        <Icon name="arrow" size={18} directional />
      </a>
    </SectionHeading>
    <FaqList locale={locale} items={faqs.slice(0, 5)} />
  </div>
</section>

<CtaBand locale={locale} source="/" />

<style>
  .hero-note {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.92rem;
    color: var(--color-muted);
  }
  .hero-note .pulse-dot {
    inline-size: 0.55rem;
    block-size: 0.55rem;
    border-radius: 99px;
    background: var(--color-teal);
  }
  .audience {
    display: grid;
    align-content: end;
    gap: 1.25rem;
    min-block-size: clamp(20rem, 16rem + 12vw, 28rem);
    padding: clamp(1.75rem, 1rem + 3vw, 3rem);
    overflow: hidden;
    background: linear-gradient(160deg, #fff 30%, var(--color-mint));
  }
  .audience-dark {
    background: linear-gradient(160deg, var(--color-navy-900), #12306b);
    color: #e7eefb;
  }
  .audience-dark .audience-title,
  .audience-dark .text-link {
    color: #fff;
  }
  .audience-dark .eyebrow {
    color: #7fe3d6;
  }
  .audience-title {
    font-size: clamp(1.6rem, 1.25rem + 1.5vw, 2.4rem);
    max-width: 22ch;
  }
  .audience-glyph {
    position: absolute;
    inset-block-start: 1.75rem;
    inset-inline-end: 1.75rem;
    display: grid;
    place-items: center;
    inline-size: 4rem;
    block-size: 4rem;
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.7);
    color: var(--color-teal-700);
    box-shadow: 0 0 0 1px var(--color-line);
    transition:
      rotate var(--dur-slow) var(--ease-out-expo),
      scale var(--dur-slow) var(--ease-out-expo);
  }
  .audience-dark .audience-glyph {
    background: rgb(255 255 255 / 0.08);
    color: #7fe3d6;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.12);
  }
  .audience:hover .audience-glyph {
    rotate: -8deg;
    scale: 1.08;
  }
  .principle {
    display: flex;
    gap: 1.5rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }
  .principle-num {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-teal-700);
  }
  .principle h3 {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem);
  }
  .dark-glow {
    position: absolute;
    inset-block-start: -20rem;
    inset-inline-start: -10rem;
    inline-size: 60rem;
    block-size: 40rem;
    background: radial-gradient(closest-side, rgb(27 78 216 / 0.35), transparent 70%);
    filter: blur(30px);
  }
  .chapter-dark :global(.process-step) {
    background: rgb(255 255 255 / 0.04);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.1);
    backdrop-filter: blur(6px);
  }
  .chapter-dark :global(.process-step .process-title) {
    color: #fff;
  }
  .chapter-dark :global(.process-bar) {
    background: rgb(255 255 255 / 0.12);
  }
  .chapter-dark :global(.process-node) {
    box-shadow: 0 0 0 6px rgb(0 178 169 / 0.18);
  }
</style>
