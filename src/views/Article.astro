---
import { render } from "astro:content";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CtaBand from "../components/CtaBand.astro";
import ArticleCard from "../components/ArticleCard.astro";
import Icon from "../components/Icon.astro";
import { engagements, localPath } from "../lib/content.ts";
import type { Locale } from "../lib/content.ts";
import { nav, common } from "../lib/copy.ts";
import { entriesFor, entryFor } from "../site/collections.ts";

interface Props {
  locale: Locale;
  collection: "insights" | "resources";
  slug: string;
}
const { locale, collection, slug } = Astro.props;
const entry = (await entryFor(collection, locale, slug))!;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const words = (entry.body ?? "").split(/\s+/).filter(Boolean).length;
const minutes = Math.max(3, Math.round(words / 220));
const fmt = new Intl.DateTimeFormat(locale === "ar" ? "ar-u-nu-latn" : "en-GB", {
  dateStyle: "long",
});
const related = engagements.filter((e) => entry.data.engagements.includes(e.id));
// Rank by shared engagements, then same audience (publish dates tie), before slicing.
const score = (d: typeof entry.data) =>
  d.engagements.filter((id) => entry.data.engagements.includes(id)).length * 2 +
  (d.audience === entry.data.audience ? 1 : 0);
const more = (await entriesFor(collection, locale))
  .filter((e) => e.slug !== slug)
  .sort((a, b) => score(b.data) - score(a.data))
  .slice(0, 3);
const sectionName = collection === "insights" ? nav.insights : nav.resources;
const kindLabel =
  "kind" in entry.data
    ? entry.data.kind === "checklist"
      ? common.checklist[locale]
      : common.guide[locale]
    : entry.data.audience === "providers"
      ? common.forProviders[locale]
      : entry.data.audience === "digital-health-companies"
        ? common.forCompanies[locale]
        : common.forBoth[locale];
---

<div class="reading-progress" aria-hidden="true">
  <span data-progress="#article-body"></span>
</div>

<header class="article-head relative isolate overflow-hidden">
  <div class="head-glow" aria-hidden="true"></div>
  <div class="container-x pt-10 pb-16 md:pt-14 md:pb-20">
    <Breadcrumbs
      locale={locale}
      trail={[
        { name: sectionName[locale], path: `/${collection}` },
        { name: entry.data.title, path: `/${collection}/${slug}` },
      ]}
    />
    <div class="hero-enter mt-10 grid max-w-4xl gap-6 md:mt-14">
      <p class="eyebrow">{kindLabel}</p>
      <h1 class="text-[clamp(2.1rem,1.4rem+3vw,4rem)]">{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
      <p class="flex flex-wrap gap-x-5 gap-y-2 text-[0.92rem] text-muted">
        <span>
          {common.published[locale]}:{" "}
          <time datetime={entry.data.published.toISOString()}>
            {fmt.format(entry.data.published)}
          </time>
        </span>
        {entry.data.updated.getTime() !== entry.data.published.getTime() && (
          <span>
            {common.updated[locale]}:{" "}
            <time datetime={entry.data.updated.toISOString()}>
              {fmt.format(entry.data.updated)}
            </time>
          </span>
        )}
        <span>
          {minutes} {common.minutes[locale]}
        </span>
        <span>ProHealth Digital</span>
      </p>
    </div>
  </div>
</header>

<section class="pb-[var(--section-y)]">
  <div class="container-x grid gap-14 lg:grid-cols-[16rem_minmax(0,1fr)]">
    <aside class="hidden lg:block">
      <nav class="article-toc" aria-label={common.onThisPage[locale]}>
        <p class="eyebrow mb-4">{common.onThisPage[locale]}</p>
        <ol class="grid gap-1">
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>
    <div class="grid max-w-3xl grid-cols-[minmax(0,1fr)] gap-12">
      <div class="key-points" data-reveal>
        <p class="eyebrow mb-4">{common.keyPoints[locale]}</p>
        <ul class="grid gap-3">
          {entry.data.summary.map((point) => (
            <li class="flex gap-3">
              <Icon name="check" size={18} class="mt-1 shrink-0 text-teal-700" />
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>
      <article class="prose" id="article-body">
        <Content />
      </article>
      {related.length > 0 && (
        <div class="grid gap-4 border-t border-[var(--color-line)] pt-10">
          <p class="eyebrow">{common.related[locale]}</p>
          <div class="grid gap-3 sm:grid-cols-2">
            {related.map((e) => (
              <a
                class="related-link card card-hover"
                href={localPath(`/solutions/${e.id}`, locale)}
              >
                <span>{e.title[locale]}</span>
                <Icon name="arrow" size={18} directional />
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</section>

{more.length > 0 && (
  <section class="section-tight bg-mint/50">
    <div class="container-x grid gap-10 py-6">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="text-[clamp(1.6rem,1.3rem+1.2vw,2.3rem)]">{common.relatedReading[locale]}</h2>
        <a class="text-link" href={localPath(`/${collection}`, locale)}>
          {collection === "insights" ? common.allInsights[locale] : common.allResources[locale]}
          <Icon name="arrow" size={18} directional />
        </a>
      </div>
      <div class="grid gap-5 md:grid-cols-3" data-reveal-stagger>
        {more.map((e, i) => (
          <ArticleCard
            locale={locale}
            href={`/${collection}/${e.slug}`}
            title={e.data.title}
            description={e.data.description}
            label={sectionName[locale]}
            index={i}
          />
        ))}
      </div>
    </div>
  </section>
)}

<CtaBand locale={locale} source={`/${collection}/${slug}`} engagement={entry.data.engagements[0]} />

<style>
  .reading-progress {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 60;
    block-size: 3px;
    pointer-events: none;
  }
  .reading-progress span {
    display: block;
    block-size: 100%;
    background: linear-gradient(90deg, var(--color-teal), var(--color-royal));
    transform-origin: left;
    transform: scaleX(0);
  }
  :global([dir="rtl"]) .reading-progress span {
    transform-origin: right;
  }
  .head-glow {
    position: absolute;
    inset-block-start: -16rem;
    inset-inline-end: -10%;
    z-index: -1;
    inline-size: 50rem;
    block-size: 36rem;
    background: radial-gradient(closest-side, rgb(0 178 169 / 0.16), transparent 70%);
    filter: blur(10px);
  }
  .article-toc {
    position: sticky;
    inset-block-start: 7rem;
  }
  .article-toc a {
    display: block;
    padding-block: 0.35rem;
    padding-inline-start: 0.9rem;
    border-inline-start: 2px solid var(--color-line);
    color: var(--color-muted);
    font-size: 0.92rem;
    line-height: 1.45;
    transition:
      color var(--dur-fast),
      border-color var(--dur-fast);
  }
  .article-toc a:hover {
    color: var(--color-ink);
    border-color: var(--color-teal);
  }
  .key-points {
    padding: 1.5rem 1.75rem;
    border-radius: 1.25rem;
    background: var(--color-mint);
  }
  .related-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    font-weight: 600;
  }
</style>
