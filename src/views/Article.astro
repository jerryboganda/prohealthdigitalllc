---
import { render } from "astro:content";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CtaBand from "../components/CtaBand.astro";
import ArticleCard from "../components/ArticleCard.astro";
import ArtGrid from "../components/ArtGrid.astro";
import Icon from "../components/Icon.astro";
import { engagements, localPath } from "../lib/content.ts";
import type { Locale } from "../lib/content.ts";
import { nav, common } from "../lib/copy.ts";
import { entriesFor, entryFor } from "../site/collections.ts";

interface Props {
  locale: Locale;
  collection: "insights" | "resources";
  slug: string;
}
const { locale, collection, slug } = Astro.props;
const entry = (await entryFor(collection, locale, slug))!;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const words = (entry.body ?? "").split(/\s+/).filter(Boolean).length;
const minutes = Math.max(3, Math.round(words / 220));
const fmt = new Intl.DateTimeFormat(locale === "ar" ? "ar-u-nu-latn" : "en-GB", {
  dateStyle: "long",
});
const related = engagements.filter((e) => entry.data.engagements.includes(e.id));
// Rank by shared engagements, then same audience (publish dates tie), before slicing.
const score = (d: typeof entry.data) =>
  d.engagements.filter((id) => entry.data.engagements.includes(id)).length * 2 +
  (d.audience === entry.data.audience ? 1 : 0);
const more = (await entriesFor(collection, locale))
  .filter((e) => e.slug !== slug)
  .sort((a, b) => score(b.data) - score(a.data))
  .slice(0, 3);
const sectionName = collection === "insights" ? nav.insights : nav.resources;
const kindLabel =
  "kind" in entry.data
    ? entry.data.kind === "checklist"
      ? common.checklist[locale]
      : common.guide[locale]
    : entry.data.audience === "providers"
      ? common.forProviders[locale]
      : entry.data.audience === "digital-health-companies"
        ? common.forCompanies[locale]
        : common.forBoth[locale];
const icons = {
  "digital-presence": "globe",
  "care-workflows": "flow",
  "platform-launch": "spark",
  "platform-improvement": "layers",
} as const;
---

<div class="lg-progressbar" data-progress="#article-body" aria-hidden="true"></div>

<section style="position: relative; overflow: hidden; isolation: isolate">
  <div
    aria-hidden="true"
    data-parallax="0.06"
    style="position: absolute; inset: -60px 0; z-index: -1; background-image: radial-gradient(rgb(31 79 224 / 0.14) 1.2px, transparent 1.6px); background-size: 26px 26px; mask-image: linear-gradient(180deg, #000 10%, transparent 85%)"
  ></div>
  <ArtGrid
    motion="spin"
    style="position: absolute; inset-inline-end: -90px; top: -40px; width: 340px; opacity: 0.16; z-index: -1; animation-duration: 70s"
  />
  <div
    class="lg-wrap"
    style="padding-top: clamp(24px, 4vw, 56px); padding-bottom: clamp(48px, 6vw, 88px)"
  >
    <div class="lg-in">
      <Breadcrumbs
        locale={locale}
        trail={[
          { name: sectionName[locale], path: `/${collection}` },
          { name: entry.data.title, path: `/${collection}/${slug}` },
        ]}
      />
    </div>
    <div style="display: grid; gap: 24px; max-width: 1000px; margin-top: clamp(28px, 4vw, 56px)">
      <p class="lg-meta lg-in lg-d1" style="margin: 0">
        <span class="lg-tag">
          <span class="lg-dot" aria-hidden="true" style="width: 8px; height: 8px"></span>
          {kindLabel}
        </span>
      </p>
      <h1
        class="lg-h1-page lg-in-solid lg-d2"
        style="font-size: clamp(36px, 5vw, 76px); max-width: 18ch"
      >
        {entry.data.title}
      </h1>
      <p class="lg-lede lg-in lg-d3" style="max-width: 62ch">
        {entry.data.description}
      </p>
      <p
        class="lg-in lg-d4"
        style="margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 22px; font-size: 15px; color: var(--muted)"
      >
        <span>
          {common.published[locale]}:{" "}
          <time datetime={entry.data.published.toISOString()}>
            {fmt.format(entry.data.published)}
          </time>
        </span>
        {entry.data.updated.getTime() !== entry.data.published.getTime() && (
          <span>
            {common.updated[locale]}:{" "}
            <time datetime={entry.data.updated.toISOString()}>
              {fmt.format(entry.data.updated)}
            </time>
          </span>
        )}
        <span style="display: inline-flex; align-items: center; gap: 8px">
          <Icon name="clock" size={18} />
          <span>{`${minutes} ${common.minutes[locale]}`}</span>
        </span>
        <span>ProHealth Digital</span>
      </p>
    </div>
  </div>
</section>

<section class="lg-white" style="padding-block: clamp(48px, 6vw, 96px) clamp(64px, 8vw, 120px)">
  <div class="lg-wrap article-grid">
    <aside class="article-aside" data-reveal="side">
      {toc.length > 0 && (
        <nav
          class="lg-card"
          aria-label={common.onThisPage[locale]}
          style="padding: 22px 16px; gap: 12px; border-radius: 24px"
        >
          <p class="lg-eyebrow" style="padding-inline: 12px">
            <span class="lg-dot" aria-hidden="true" style="background: var(--royal)" />
            {common.onThisPage[locale]}
          </p>
          <ol class="lg-toc">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
      <ArtGrid
        size="sm"
        motion="float"
        class="article-art"
        style="width: 96px; margin-inline-start: 16px"
      />
    </aside>

    <div style="display: grid; grid-template-columns: minmax(0, 1fr); gap: 48px; min-width: 0; max-width: 780px">
      <div class="lg-callout" data-reveal="scale" style="padding: clamp(24px, 3vw, 36px)">
        <p class="lg-eyebrow">
          <span class="lg-dot" aria-hidden="true" style="background: var(--teal-ink)"></span>
          {common.keyPoints[locale]}
        </p>
        <ul class="lg-checklist" style="gap: 16px">
          {entry.data.summary.map((point, i) => (
            <li style="align-items: flex-start; color: var(--ink)">
              <span
                class="lg-box"
                aria-hidden="true"
                style={`margin-top: 1px; animation-delay: ${i * 0.5}s`}
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#fff"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    class="lg-check"
                    style={`animation-delay: ${i * 0.5}s`}
                    d="M5 12.5l4.5 4.5L19 7.5"
                  />
                </svg>
              </span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>

      <article class="lg-prose" id="article-body">
        <Content />
      </article>

      {related.length > 0 && (
        <div
          data-reveal
          style="display: grid; gap: 16px; border-top: 1px solid var(--line); padding-top: 40px"
        >
          <h2 class="lg-eyebrow">
            <span class="lg-dot" aria-hidden="true" />
            {common.related[locale]}
          </h2>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 12px">
            {related.map((e, i) => (
              <article
                class="lg-card lg-card-link"
                style="grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 16px; padding: 18px; padding-inline-start: 20px; border-radius: 22px"
              >
                <span
                  class:list={["lg-ico", i % 2 === 1 && "lg-ico-teal"]}
                  aria-hidden="true"
                  style="width: 46px; height: 46px; border-radius: 14px"
                >
                  <Icon name={icons[e.id]} size={22} />
                </span>
                <h3 style="margin: 0; font-size: 17px; font-weight: 600; line-height: 1.3">
                  <a class="lg-stretch" href={localPath(`/solutions/${e.id}`, locale)}>
                    {e.title[locale]}
                  </a>
                </h3>
                <span class="lg-go" aria-hidden="true" style="width: 42px; height: 42px">
                  <Icon name="arrow" size={18} class="lg-arrow" />
                </span>
              </article>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</section>

{more.length > 0 && (
  <section class="lg-section lg-tint">
    <div class="lg-wrap" style="display: grid; gap: 44px">
      <div class="lg-row">
        <SectionHeading title={common.relatedReading[locale]} />
        <a class="lg-link" href={localPath(`/${collection}`, locale)}>
          {collection === "insights" ? common.allInsights[locale] : common.allResources[locale]}
          <Icon name="arrow" size={18} class="lg-arrow" />
        </a>
      </div>
      <div class="lg-grid-3" data-reveal-stagger>
        {more.map((e, i) => (
          <ArticleCard
            locale={locale}
            href={`/${collection}/${e.slug}`}
            title={e.data.title}
            description={e.data.description}
            label={sectionName[locale]}
            index={i}
            cta={collection === "resources" ? common.openResource[locale] : undefined}
          />
        ))}
      </div>
    </div>
  </section>
)}

<CtaBand locale={locale} source={`/${collection}/${slug}`} engagement={entry.data.engagements[0]} />

<style>
  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .article-aside {
    display: grid;
    gap: 16px;
    min-width: 0;
  }
  .article-aside :global(.article-art) {
    display: none;
  }
  @media (min-width: 1024px) {
    .article-grid {
      grid-template-columns: 16rem minmax(0, 1fr);
    }
    .article-aside {
      position: sticky;
      top: 112px;
    }
    .article-aside :global(.article-art) {
      display: grid;
    }
  }
  /* Code, paths and attributes stay left-to-right inside Arabic prose. */
  .lg-prose :global(code) {
    direction: ltr;
    unicode-bidi: isolate;
    overflow-wrap: anywhere;
  }
</style>
