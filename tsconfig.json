{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src", "scripts", "tests", "astro.config.mjs"],
  "exclude": [".output", "video", ".claude", "node_modules"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
